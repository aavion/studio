{
    "name": "aavion/studio",
    "description": "Symfony 8.1 based content-management system for structured project websites",
    "type": "project",
    "license": ["MIT"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.21"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "ext-xml": "*",
        "doctrine/dbal": "^4.4.3",
        "doctrine/doctrine-bundle": "^3.2.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.7",
        "dragonmantank/cron-expression": "^3.6",
        "geoip2/geoip2": "^3.3",
        "justinrainbow/json-schema": "^6.9.0",
        "league/commonmark": "^2.8.2",
        "league/flysystem-bundle": "^3.7",
        "mck89/peast": "^1.17.6",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.2",
        "sabberworm/php-css-parser": "^9.3",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.10",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "8.1.*",
        "symfony/polyfill-php85": "^1.38",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.1",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-autocomplete": "^3.1",
        "symfony/ux-calendar-link": "^3.1",
        "symfony/ux-chartjs": "^3.1",
        "symfony/ux-cropperjs": "^3.1",
        "symfony/ux-dropzone": "^3.1",
        "symfony/ux-icons": "^3.1",
        "symfony/ux-live-component": "^3.1",
        "symfony/ux-map": "^3.1",
        "symfony/ux-native": "^3.1",
        "symfony/ux-notify": "^3.1",
        "symfony/ux-react": "^3.1",
        "symfony/ux-translator": "^3.1",
        "symfony/ux-turbo": "^3.1",
        "symfony/ux-twig-component": "^3.1",
        "symfony/ux-vue": "^3.1",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/tailwind-bundle": "^0.13",
        "twig/extra-bundle": "^3.24",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "8.1.*",
        "symfony/ux-toolkit": "^3.1",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        }
    },
    "autoload": {
        "exclude-from-classmap": [
            "tests/Fixtures/",
            "packages/"
        ],
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "tailwind:build": "symfony-cmd"
        },
        "post-install-cmd": [
            "@php bin/ensure-package-asset-registries",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@php bin/ensure-package-asset-registries",
            "@auto-scripts"
        ]
    }
}
