{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'pkg.demo-module.demo.frontend.title'|trans }}{% endblock %}

{% block frontend_body %}
    {% set demo_base = package_setting('demo-module', 'demo.route', 'demo')|default('demo')|trim('/') %}
    {% set demo_base = demo_base == '' ? 'demo' : demo_base %}

    <section class="system-frontend-content-page demo-module-frontend-demo">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            kicker: 'pkg.demo-module.demo.kicker'|trans,
            title: 'pkg.demo-module.demo.frontend.title'|trans,
            subtitle: 'pkg.demo-module.demo.frontend.subtitle'|trans,
        } only %}

        {% include '@frontend/partials/actions/_button-group.html.twig' with {
            actions: [
                {label: 'pkg.demo-module.navigation.backend'|trans, href: path('content_show', {path: demo_base ~ '/backend'}), variant: 'primary'},
                {label: 'pkg.demo-module.navigation.typography'|trans, href: path('content_show', {path: demo_base ~ '/typography'}), variant: 'secondary'},
            ],
        } only %}

        <div class="demo-module-grid">
            <section class="system-panel">
                <h2>{{ 'pkg.demo-module.demo.frontend.content_title'|trans }}</h2>
                <p class="system-muted">{{ 'pkg.demo-module.demo.frontend.content_text'|trans }}</p>
                <div class="system-rich-text">
                    <p>{{ 'pkg.demo-module.demo.frontend.rich_text'|trans }}</p>
                </div>
            </section>

            {% include '@frontend/partials/feedback/_empty-state.html.twig' with {
                title: 'pkg.demo-module.demo.empty.title'|trans,
                message: 'pkg.demo-module.demo.empty.message'|trans,
            } only %}
        </div>

        <section class="system-panel">
            <header class="system-page-header">
                <div>
                    <p class="system-kicker">{{ 'pkg.demo-module.demo.form.kicker'|trans }}</p>
                    <h2>{{ 'pkg.demo-module.demo.form.title'|trans }}</h2>
                </div>
                <span class="system-badge system-badge-info">{{ 'pkg.demo-module.demo.badges.info'|trans }}</span>
            </header>

            <div class="demo-module-grid">
                {% include '@frontend/partials/forms/_field.html.twig' with {
                    id: 'demo_frontend_title',
                    label: 'pkg.demo-module.demo.form.title_label'|trans,
                    required: true,
                    help: 'pkg.demo-module.demo.form.help'|trans,
                    control: '<input id="demo_frontend_title" class="system-control" value="' ~ ('pkg.demo-module.demo.form.value'|trans|e('html_attr')) ~ '">',
                } only %}
                {% include '@frontend/partials/forms/_field.html.twig' with {
                    id: 'demo_frontend_status',
                    label: 'pkg.demo-module.demo.form.status_label'|trans,
                    control: '<select id="demo_frontend_status" class="system-control"><option>' ~ ('pkg.demo-module.demo.form.status_option'|trans|e) ~ '</option></select>',
                } only %}
            </div>
        </section>

        <section class="system-panel">
            <h2>{{ 'pkg.demo-module.demo.status.title'|trans }}</h2>
            <div class="system-page-actions">
                <span class="system-badge system-badge-success">{{ 'pkg.demo-module.demo.badges.success'|trans }}</span>
                <span class="system-badge system-badge-info">{{ 'pkg.demo-module.demo.badges.info'|trans }}</span>
                <span class="system-badge system-badge-warning">{{ 'pkg.demo-module.demo.badges.warning'|trans }}</span>
                <span class="system-badge system-badge-error">{{ 'pkg.demo-module.demo.badges.error'|trans }}</span>
            </div>
        </section>
    </section>
{% endblock %}
