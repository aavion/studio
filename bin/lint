#!/usr/bin/env php
<?php

declare(strict_types=1);

ini_set('memory_limit', '512M');
ini_set('max_execution_time', 0);

require dirname(__DIR__).'/vendor/autoload.php';

use App\Core\Lint\CssLinter;
use App\Core\Lint\JavaScriptLinter;
use App\Core\Lint\JsonLinter;
use App\Core\Lint\LinterInterface;
use League\CommonMark\GithubFlavoredMarkdownConverter;
use Symfony\Component\Yaml\Yaml;

$root = dirname(__DIR__);
$php = PHP_BINARY;
$failures = 0;
$options = parseLintArguments(array_slice($argv, 1));

if ($options['help']) {
    printLintUsage();

    exit(0);
}

$targets = $options['targets'];
$diffMode = $options['diff'];
$diffRange = $options['diff_range'];
$stagedMode = $options['staged'];

if (($diffMode || $stagedMode) && [] !== $targets) {
    fwrite(STDERR, "The --diff and --staged options cannot be combined with explicit lint targets.\n");

    exit(1);
}

if ($diffMode && $stagedMode) {
    fwrite(STDERR, "The --diff and --staged options cannot be combined.\n");

    exit(1);
}

/**
 * @param list<string> $arguments
 *
 * @return array{targets: list<string>, diff: bool, diff_range: ?string, staged: bool, help: bool}
 */
function parseLintArguments(array $arguments): array
{
    $targets = [];
    $diff = false;
    $diffRange = null;
    $staged = false;
    $help = false;

    for ($index = 0; $index < count($arguments); ++$index) {
        $argument = $arguments[$index];

        if ('--help' === $argument || '-h' === $argument) {
            $help = true;

            continue;
        }

        if ('--staged' === $argument) {
            $staged = true;

            continue;
        }

        if (str_starts_with($argument, '--changed=')) {
            $diff = true;
            $diffRange = substr($argument, 10) ?: null;

            continue;
        }

        if ('--diff' === $argument) {
            $diff = true;
            $next = $arguments[$index + 1] ?? null;

            if (is_string($next) && !str_starts_with($next, '-') && str_contains($next, '..')) {
                $diffRange = $next;
                ++$index;
            }

            continue;
        }

        if (str_starts_with($argument, '--diff=') || str_starts_with($argument, '--diff:')) {
            $diff = true;
            $diffRange = substr($argument, 7) ?: null;

            continue;
        }

        $targets[] = $argument;
    }

    return [
        'targets' => $targets,
        'diff' => $diff,
        'diff_range' => $diffRange,
        'staged' => $staged,
        'help' => $help,
    ];
}

function printLintUsage(): void
{
    fwrite(STDOUT, <<<'USAGE'
Usage:
  bin/lint
  bin/lint <file-or-directory>...
  bin/lint --diff
  bin/lint --diff=<target..source>
  bin/lint --diff:<target..source>
  bin/lint --changed=<target..source>
  bin/lint --staged

Options:
  --diff                  Lint supported files changed in the staged or unstaged Git diff.
  --diff=<range>          Lint supported files changed in the given Git diff range.
  --diff:<range>          Alternative range syntax for shells where it reads better.
  --changed=<range>       Alias for --diff=<range>.
  --staged                Lint supported files changed in the staged Git diff.
  -h, --help              Show this help.

USAGE);
}

function nullDevice(): string
{
    return '\\' === DIRECTORY_SEPARATOR ? 'NUL' : '/dev/null';
}

$run = static function (array $command, string $label) use (&$failures, $root): void {
    fwrite(STDOUT, sprintf("\n==> %s\n", $label));
    $process = proc_open(
        $command,
        [
            0 => STDIN,
            1 => STDOUT,
            2 => STDERR,
        ],
        $pipes,
        $root,
    );

    if (!is_resource($process)) {
        fwrite(STDERR, sprintf("Failed to start %s.\n", $label));
        ++$failures;

        return;
    }

    $exitCode = proc_close($process);

    if (0 !== $exitCode) {
        ++$failures;
    }
};

/**
 * @param list<string> $extensions
 *
 * @return list<string>
 */
function filesWithExtensions(string $root, array $extensions): array
{
    $excluded = [
        '.git',
        'assets/packages',
        'node_modules',
        'public/assets',
        'tests/Fixtures',
        'var',
        'vendor',
    ];
    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveCallbackFilterIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
            static function (SplFileInfo $file) use ($root, $excluded): bool {
                $relative = str_replace('\\', '/', substr($file->getPathname(), strlen($root) + 1));

                foreach ($excluded as $path) {
                    if ($relative === $path || str_starts_with($relative, $path.'/')) {
                        return false;
                    }
                }

                return true;
            },
        ),
    );

    $extensions = array_flip($extensions);

    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) {
            continue;
        }

        $extension = lintFileType($file->getPathname());

        if (null !== $extension && isset($extensions[$extension])) {
            $files[] = $file->getPathname();
        }
    }

    sort($files);

    return $files;
}

/**
 * @param list<string> $files
 */
function lintPhpFiles(string $root, array $files, string $php): int
{
    fwrite(STDOUT, "\n==> PHP syntax\n");
    $failures = 0;

    foreach ($files as $file) {
        $process = proc_open(
            [$php, '-l', $file],
            [
                0 => ['file', nullDevice(), 'r'],
                1 => ['pipe', 'w'],
                2 => STDERR,
            ],
            $pipes,
            $root,
        );

        if (!is_resource($process)) {
            fwrite(STDERR, sprintf("Failed to lint %s.\n", relativePath($root, $file)));
            ++$failures;

            continue;
        }

        $output = stream_get_contents($pipes[1]);
        fclose($pipes[1]);
        $exitCode = proc_close($process);

        if (0 !== $exitCode) {
            fwrite(STDOUT, (string) $output);
            ++$failures;
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, "PHP syntax OK.\n");
    }

    return $failures;
}

/**
 * @param list<string> $files
 */
function lintSourceFiles(string $root, array $files, LinterInterface $linter, string $label): int
{
    fwrite(STDOUT, sprintf("\n==> %s\n", $label));
    $failures = 0;

    foreach ($files as $file) {
        $relative = relativePath($root, $file);

        $result = $linter->lint((string) file_get_contents($file), $relative);

        foreach ($result->issues() as $issue) {
            fwrite(STDERR, sprintf(
                "%s:%s:%s %s\n",
                $relative,
                $issue->line() ?? 1,
                $issue->column() ?? 1,
                $issue->details()['error'] ?? $issue->message(),
            ));
            ++$failures;
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, sprintf("%s OK.\n", $label));
    }

    return $failures;
}

/**
 * @param list<string> $files
 */
function lintCssFiles(string $root, array $files): int
{
    fwrite(STDOUT, "\n==> CSS syntax\n");
    $failures = 0;
    $linter = new CssLinter();

    foreach ($files as $file) {
        $relative = relativePath($root, $file);
        $contents = (string) file_get_contents($file);
        $result = $linter->lint($contents, $relative);

        foreach ($result->issues() as $issue) {
            if (isTailwindDirectiveCssIssue($contents, $issue->line())) {
                fwrite(STDOUT, sprintf(
                    "%s:%s:%s strict CSS parser skipped a Tailwind directive; tailwind:build remains authoritative for this file.\n",
                    $relative,
                    $issue->line() ?? 1,
                    $issue->column() ?? 1,
                ));

                continue;
            }

            fwrite(STDERR, sprintf(
                "%s:%s:%s %s\n",
                $relative,
                $issue->line() ?? 1,
                $issue->column() ?? 1,
                $issue->details()['error'] ?? $issue->message(),
            ));
            ++$failures;
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, "CSS syntax OK.\n");
    }

    return $failures;
}

function isTailwindDirectiveCssIssue(string $contents, ?int $line): bool
{
    if (null === $line) {
        return false;
    }

    $lines = preg_split('/\R/', $contents) ?: [];
    $texts = [
        trim((string) ($lines[$line - 2] ?? '')),
        trim((string) ($lines[$line - 1] ?? '')),
        trim((string) ($lines[$line] ?? '')),
    ];

    foreach ($texts as $text) {
        if (str_starts_with($text, '@apply ')
            || str_starts_with($text, '@theme ')
            || str_starts_with($text, '@custom-variant ')
            || str_starts_with($text, '@source ')
        ) {
            return true;
        }
    }

    return false;
}

/**
 * @param list<string> $files
 */
function lintMarkdownFiles(string $root, array $files): int
{
    fwrite(STDOUT, "\n==> Markdown parse\n");

    $converter = new GithubFlavoredMarkdownConverter([
        'html_input' => 'escape',
        'allow_unsafe_links' => false,
    ]);
    $failures = 0;

    foreach ($files as $file) {
        $relative = relativePath($root, $file);

        try {
            $converter->convert((string) file_get_contents($file));
        } catch (Throwable $error) {
            fwrite(STDERR, sprintf(
                "%s:1:1 Markdown parse failed: %s\n",
                $relative,
                $error->getMessage(),
            ));
            ++$failures;
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, "Markdown parse OK.\n");
    }

    return $failures;
}

/**
 * @param list<string> $files
 */
function lintUxIconReferences(string $root, array $files): int
{
    fwrite(STDOUT, "\n==> Symfony UX icon references\n");

    $config = uxIconLintConfig($root);
    $failures = 0;

    foreach ($files as $file) {
        $relative = relativePath($root, $file);
        $contents = (string) file_get_contents($file);

        foreach (extractUxIconReferences($contents) as $reference) {
            if (localUxIconExists($reference['name'], $config)) {
                continue;
            }

            ++$failures;
            fwrite(STDERR, sprintf(
                "%s:%d:1 Missing local Symfony UX icon \"%s\". Run php bin/console ux:icons:lock when Iconify is reachable.\n",
                $relative,
                $reference['line'],
                $reference['name'],
            ));
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, "Symfony UX icon references OK.\n");
    }

    return $failures;
}

/**
 * @return array{icon_dir: string, aliases: array<string, string>, icon_set_paths: array<string, string>}
 */
function uxIconLintConfig(string $root): array
{
    $configPath = $root.'/config/packages/ux_icons.yaml';
    $config = is_file($configPath) ? (array) Yaml::parseFile($configPath) : [];
    $uxIcons = is_array($config['ux_icons'] ?? null) ? $config['ux_icons'] : [];
    $aliases = is_array($uxIcons['aliases'] ?? null) ? $uxIcons['aliases'] : [];
    $iconSets = is_array($uxIcons['icon_sets'] ?? null) ? $uxIcons['icon_sets'] : [];
    $iconSetPaths = [];

    foreach ($iconSets as $prefix => $iconSet) {
        if (!is_string($prefix) || !is_array($iconSet) || !is_string($iconSet['path'] ?? null)) {
            continue;
        }

        $iconSetPaths[$prefix] = resolveProjectPath($root, $iconSet['path']);
    }

    return [
        'icon_dir' => resolveProjectPath($root, is_string($uxIcons['icon_dir'] ?? null) ? $uxIcons['icon_dir'] : '%kernel.project_dir%/assets/icons'),
        'aliases' => array_filter($aliases, static fn (mixed $target, mixed $alias): bool => is_string($alias) && is_string($target), ARRAY_FILTER_USE_BOTH),
        'icon_set_paths' => $iconSetPaths,
    ];
}

function resolveProjectPath(string $root, string $path): string
{
    $path = str_replace('%kernel.project_dir%', $root, $path);

    return str_starts_with($path, DIRECTORY_SEPARATOR) ? $path : $root.DIRECTORY_SEPARATOR.$path;
}

/**
 * @return list<array{name: string, line: int}>
 */
function extractUxIconReferences(string $contents): array
{
    $iconName = '[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)*';
    $patterns = [
        '/\bux_icon\s*\(\s*[\'"](?P<name>'.$iconName.')[\'"]/',
        '/<twig:ux:icon\b[^>]*\bname\s*=\s*[\'"](?P<name>'.$iconName.')[\'"][^>]*>/i',
    ];
    $references = [];

    foreach ($patterns as $pattern) {
        if (!preg_match_all($pattern, $contents, $matches, PREG_SET_ORDER | PREG_OFFSET_CAPTURE)) {
            continue;
        }

        foreach ($matches as $match) {
            $name = $match['name'][0];
            $offset = $match['name'][1];
            $references[$name.'@'.$offset] = [
                'name' => $name,
                'line' => substr_count(substr($contents, 0, $offset), "\n") + 1,
            ];
        }
    }

    return array_values($references);
}

/**
 * @param array{icon_dir: string, aliases: array<string, string>, icon_set_paths: array<string, string>} $config
 */
function localUxIconExists(string $name, array $config): bool
{
    $iconName = $config['aliases'][$name] ?? $name;

    if (str_contains($iconName, ':')) {
        [$prefix, $icon] = explode(':', $iconName, 2);
        if (isset($config['icon_set_paths'][$prefix]) && is_file($config['icon_set_paths'][$prefix].DIRECTORY_SEPARATOR.str_replace(':', DIRECTORY_SEPARATOR, $icon).'.svg')) {
            return true;
        }
    }

    return is_file($config['icon_dir'].DIRECTORY_SEPARATOR.str_replace(':', DIRECTORY_SEPARATOR, $iconName).'.svg');
}

/**
 * @param list<string> $prefixes
 */
function pathMatchesAnyPrefix(string $path, array $prefixes): bool
{
    foreach ($prefixes as $prefix) {
        if ($path === $prefix || str_starts_with($path, rtrim($prefix, '/').'/')) {
            return true;
        }
    }

    return false;
}

/**
 * @param list<string> $targets
 *
 * @return array{files: list<string>, failures: int}
 */
function collectTargetFiles(string $root, array $targets): array
{
    $supportedExtensions = ['css', 'js', 'json', 'md', 'php', 'twig', 'yaml', 'yml'];
    $files = [];
    $failures = 0;

    foreach ($targets as $target) {
        $path = absolutePath($root, $target);

        if (null === $path || (!is_file($path) && !is_dir($path))) {
            fwrite(STDERR, sprintf("Lint target not found: %s\n", $target));
            ++$failures;

            continue;
        }

        if (is_file($path)) {
            $extension = lintFileType($path);

            if (null === $extension || !in_array($extension, $supportedExtensions, true)) {
                fwrite(STDOUT, sprintf("Skipping unsupported lint target: %s\n", relativePath($root, $path)));

                continue;
            }

            $files[$path] = true;

            continue;
        }

        $relativePrefix = relativePath($root, $path);

        foreach (filesWithExtensions($root, $supportedExtensions) as $file) {
            if (pathMatchesAnyPrefix(relativePath($root, $file), [$relativePrefix])) {
                $files[$file] = true;
            }
        }
    }

    $files = array_keys($files);
    sort($files);

    return ['files' => $files, 'failures' => $failures];
}

function absolutePath(string $root, string $path): ?string
{
    $candidate = str_starts_with($path, DIRECTORY_SEPARATOR)
        ? $path
        : $root.DIRECTORY_SEPARATOR.$path;
    $real = realpath($candidate);

    if (!is_string($real) || !pathMatchesAnyPrefix(str_replace('\\', '/', $real), [str_replace('\\', '/', $root)])) {
        return null;
    }

    return $real;
}

function relativePath(string $root, string $path): string
{
    return str_replace('\\', '/', substr($path, strlen($root) + 1));
}

function lintFileType(string $path): ?string
{
    $extension = strtolower(pathinfo($path, PATHINFO_EXTENSION));

    if ('' !== $extension) {
        return $extension;
    }

    $handle = @fopen($path, 'r');

    if (!is_resource($handle)) {
        return null;
    }

    $start = (string) fread($handle, 128);
    fclose($handle);

    if (str_starts_with($start, '<?php') || str_starts_with($start, "#!/usr/bin/env php\n")) {
        return 'php';
    }

    return null;
}

function gitAvailable(string $root): bool
{
    $result = runCapturedCommand(['git', '--version'], $root);

    return $result['started'] && 0 === $result['exit_code'];
}

function gitRepositoryAvailable(string $root): bool
{
    if (!gitAvailable($root)) {
        return false;
    }

    $result = runCapturedCommand(['git', 'rev-parse', '--is-inside-work-tree'], $root);

    return $result['started'] && 0 === $result['exit_code'] && in_array('true', $result['lines'], true);
}

/**
 * @param list<string> $command
 *
 * @return array{started: bool, exit_code: int, lines: list<string>}
 */
function runCapturedCommand(array $command, string $cwd): array
{
    $process = proc_open(
        $command,
        [
            0 => ['file', nullDevice(), 'r'],
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ],
        $pipes,
        $cwd,
    );

    if (!is_resource($process)) {
        return ['started' => false, 'exit_code' => 127, 'lines' => []];
    }

    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    $exitCode = proc_close($process);
    $lines = array_values(array_filter(
        array_map('rtrim', explode(PHP_EOL, trim((string) $stdout.PHP_EOL.(string) $stderr))),
        static fn (string $line): bool => '' !== $line,
    ));

    return ['started' => true, 'exit_code' => $exitCode, 'lines' => $lines];
}

/**
 * @return array{files: list<string>, failures: int}
 */
function collectDiffTargetFiles(string $root, ?string $range, bool $stagedOnly = false): array
{
    if (!gitRepositoryAvailable($root)) {
        fwrite(STDOUT, "Git is not available or this is not a Git work tree; skipping diff target collection.\n");

        return ['files' => [], 'failures' => 0];
    }

    $paths = [];
    $commands = $stagedOnly
        ? [
            ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMRTUXB', '--'],
        ]
        : (null === $range
        ? [
            ['git', 'diff', '--name-only', '--diff-filter=ACMRTUXB', '--'],
            ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMRTUXB', '--'],
        ]
        : [
            ['git', 'diff', '--name-only', '--diff-filter=ACMRTUXB', $range, '--'],
        ]);

    foreach ($commands as $command) {
        $result = runCapturedCommand($command, $root);

        if (0 !== $result['exit_code']) {
            foreach ($result['lines'] as $line) {
                fwrite(STDERR, $line.PHP_EOL);
            }

            return ['files' => [], 'failures' => 1];
        }

        foreach ($result['lines'] as $line) {
            $paths[$line] = true;
        }
    }

    return collectTargetFiles($root, array_keys($paths));
}

function lintGitDiffWhitespace(string $root, ?string $range, bool $stagedOnly = false): int
{
    fwrite(STDOUT, "\n==> Git diff whitespace\n");

    if (!gitRepositoryAvailable($root)) {
        fwrite(STDOUT, "Git is not available or this is not a Git work tree; skipping git diff whitespace check.\n");

        return 0;
    }

    $commands = $stagedOnly
        ? [
            ['git', 'diff', '--cached', '--check', '--', ':!:*.md'],
        ]
        : (null === $range
        ? [
            ['git', 'diff', '--check', '--', ':!:*.md'],
            ['git', 'diff', '--cached', '--check', '--', ':!:*.md'],
        ]
        : [
            ['git', 'diff', '--check', $range, '--', ':!:*.md'],
        ]);
    $failures = 0;

    foreach ($commands as $command) {
        $result = runCapturedCommand($command, $root);

        if (0 === $result['exit_code']) {
            continue;
        }

        ++$failures;

        foreach ($result['lines'] as $line) {
            fwrite(STDERR, $line.PHP_EOL);
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, "Git diff whitespace OK.\n");
    }

    return $failures;
}

/**
 * @param list<string> $files
 *
 * @return array<string, list<string>>
 */
function groupFilesByExtension(array $files): array
{
    $groups = [];

    foreach ($files as $file) {
        $extension = lintFileType($file);

        if (null === $extension) {
            continue;
        }

        $groups[$extension][] = $file;
    }

    ksort($groups);

    return $groups;
}

/**
 * @param list<string> $files
 */
function containsTranslationSource(string $root, array $files): bool
{
    foreach ($files as $file) {
        if (pathMatchesAnyPrefix(relativePath($root, $file), ['translations/languages'])) {
            return true;
        }
    }

    return false;
}

/**
 * @param list<string> $files
 */
function containsUxIconConfig(string $root, array $files): bool
{
    foreach ($files as $file) {
        if ('config/packages/ux_icons.yaml' === relativePath($root, $file)) {
            return true;
        }
    }

    return false;
}

/**
 * @return list<string>
 */
function uxIconTemplateFiles(string $root): array
{
    $collected = collectTargetFiles($root, ['templates', 'packages']);
    $groups = groupFilesByExtension($collected['files']);

    return $groups['twig'] ?? [];
}

function lintTranslationSourceKeys(string $root): int
{
    fwrite(STDOUT, "\n==> Translation source keys\n");

    $translationDirectory = $root.'/translations/languages';
    $localeDirectories = translationLocaleDirectories($translationDirectory);
    $referenceLocale = isset($localeDirectories['en']) ? 'en' : array_key_first($localeDirectories);
    $failures = 0;

    if (null === $referenceLocale) {
        fwrite(STDERR, "No translation source locale directories found.\n");

        return 1;
    }

    foreach ($localeDirectories as $locale => $directory) {
        try {
            mergedTranslationLocaleCatalogue($directory);
        } catch (RuntimeException $error) {
            ++$failures;
            fwrite(STDERR, sprintf("%s: %s\n", $locale, $error->getMessage()));
        }
    }

    $referenceCatalogues = translationSourceCatalogues($localeDirectories[$referenceLocale]);

    foreach ($localeDirectories as $locale => $directory) {
        $catalogues = translationSourceCatalogues($directory);

        foreach (array_keys(array_diff_key($referenceCatalogues, $catalogues)) as $domain) {
            ++$failures;
            fwrite(STDERR, sprintf("%s: missing source catalogue %s.yaml from reference locale %s\n", $locale, $domain, $referenceLocale));
        }

        foreach (array_keys(array_diff_key($catalogues, $referenceCatalogues)) as $domain) {
            ++$failures;
            fwrite(STDERR, sprintf("%s: extra source catalogue %s.yaml missing from reference locale %s\n", $locale, $domain, $referenceLocale));
        }

        foreach (array_intersect(array_keys($referenceCatalogues), array_keys($catalogues)) as $domain) {
            $referenceKeys = flattenTranslationCatalogue((array) Yaml::parseFile($referenceCatalogues[$domain]));
            $localeKeys = flattenTranslationCatalogue((array) Yaml::parseFile($catalogues[$domain]));

            foreach (array_keys(array_diff_key($referenceKeys, $localeKeys)) as $key) {
                ++$failures;
                fwrite(STDERR, sprintf("%s: missing %s key %s from reference locale %s\n", $domain, $locale, $key, $referenceLocale));
            }

            foreach (array_keys(array_diff_key($localeKeys, $referenceKeys)) as $key) {
                ++$failures;
                fwrite(STDERR, sprintf("%s: extra %s key %s missing from reference locale %s\n", $domain, $locale, $key, $referenceLocale));
            }
        }
    }

    if (0 === $failures) {
        fwrite(STDOUT, "Translation source keys OK.\n");
    }

    return $failures;
}

/**
 * @return array<string, string>
 */
function translationLocaleDirectories(string $translationDirectory): array
{
    $directories = [];

    foreach (glob($translationDirectory.'/*', GLOB_ONLYDIR) ?: [] as $directory) {
        $locale = basename($directory);
        if (1 === preg_match('/^[a-z][a-z0-9]*(?:[_-][a-zA-Z0-9]+)*$/', $locale)) {
            $directories[$locale] = $directory;
        }
    }

    ksort($directories);

    return $directories;
}

/**
 * @return array<string, string>
 */
function translationSourceCatalogues(string $directory): array
{
    $catalogues = [];

    foreach (glob($directory.'/*.yaml') ?: [] as $path) {
        $catalogues[basename($path, '.yaml')] = $path;
    }

    ksort($catalogues);

    return $catalogues;
}

/**
 * @return array<string, mixed>
 */
function mergedTranslationLocaleCatalogue(string $directory): array
{
    $catalogue = [];
    $files = glob($directory.'/*.yaml') ?: [];
    sort($files);

    foreach ($files as $file) {
        $catalogue = mergeTranslationCatalogue($catalogue, (array) Yaml::parseFile($file), $file);
    }

    return $catalogue;
}

/**
 * @param array<string, mixed> $left
 * @param array<string, mixed> $right
 *
 * @return array<string, mixed>
 */
function mergeTranslationCatalogue(array $left, array $right, string $source, string $prefix = ''): array
{
    foreach ($right as $key => $value) {
        $path = '' === $prefix ? (string) $key : $prefix.'.'.(string) $key;

        if (!array_key_exists($key, $left)) {
            $left[$key] = $value;

            continue;
        }

        if (is_array($left[$key]) && is_array($value)) {
            $left[$key] = mergeTranslationCatalogue($left[$key], $value, $source, $path);

            continue;
        }

        throw new RuntimeException(sprintf('duplicate key "%s" in %s', $path, $source));
    }

    return $left;
}

/**
 * @param array<string, mixed> $data
 *
 * @return array<string, mixed>
 */
function flattenTranslationCatalogue(array $data, string $prefix = ''): array
{
    $flat = [];

    foreach ($data as $key => $value) {
        $path = '' === $prefix ? (string) $key : $prefix.'.'.(string) $key;

        if (is_array($value)) {
            $flat += flattenTranslationCatalogue($value, $path);

            continue;
        }

        $flat[$path] = $value;
    }

    return $flat;
}

if ($diffMode || $stagedMode || [] !== $targets) {
    $collected = ($diffMode || $stagedMode)
        ? collectDiffTargetFiles($root, $diffRange, $stagedMode)
        : collectTargetFiles($root, $targets);
    $failures += $collected['failures'];
    $filesByExtension = groupFilesByExtension($collected['files']);

    if (isset($filesByExtension['php'])) {
        $failures += lintPhpFiles($root, $filesByExtension['php'], $php);
    }

    $twigFiles = $filesByExtension['twig'] ?? [];
    if ([] !== $twigFiles) {
        $run([$php, 'bin/console', 'lint:twig', ...$twigFiles], 'Twig templates');
    }

    $iconTwigFiles = containsUxIconConfig($root, $collected['files']) ? uxIconTemplateFiles($root) : $twigFiles;
    if ([] !== $iconTwigFiles) {
        $failures += lintUxIconReferences($root, $iconTwigFiles);
    }

    $yamlFiles = [...($filesByExtension['yaml'] ?? []), ...($filesByExtension['yml'] ?? [])];
    if ([] !== $yamlFiles) {
        $run([$php, 'bin/console', 'lint:yaml', '--parse-tags', ...$yamlFiles], 'YAML files');
    }

    if (isset($filesByExtension['js'])) {
        $failures += lintSourceFiles($root, $filesByExtension['js'], new JavaScriptLinter(), 'JavaScript module syntax');
    }

    if (isset($filesByExtension['json'])) {
        $failures += lintSourceFiles($root, $filesByExtension['json'], new JsonLinter(), 'JSON syntax');
    }

    if (isset($filesByExtension['md'])) {
        $failures += lintMarkdownFiles($root, $filesByExtension['md']);
    }

    if (isset($filesByExtension['css'])) {
        fwrite(STDOUT, "\nNote: focused CSS lint uses the strict CSS parser and may report Tailwind-specific directives or generated modern at-rules such as @apply, @theme, or @supports as unsupported syntax.\n");
        $failures += lintCssFiles($root, $filesByExtension['css']);
    }

    if (containsTranslationSource($root, $collected['files'])) {
        $failures += lintTranslationSourceKeys($root);
    }

    $failures += lintGitDiffWhitespace($root, $diffMode ? $diffRange : null, $stagedMode);

    if ([] === $collected['files'] && 0 === $failures) {
        fwrite(STDOUT, ($diffMode || $stagedMode) ? "No supported changed lint targets found.\n" : "No supported lint targets found.\n");
    }

    if (0 !== $failures) {
        fwrite(STDERR, sprintf("\nLint failed with %d failing check(s).\n", $failures));

        exit(1);
    }

    fwrite(STDOUT, "\nSelected lint checks passed.\n");

    exit(0);
}

$failures += lintPhpFiles($root, filesWithExtensions($root, ['php']), $php);
$run([$php, 'bin/console', 'lint:container'], 'Symfony container');
$run([$php, 'bin/console', 'lint:twig', 'templates'], 'Twig templates');
$failures += lintUxIconReferences($root, uxIconTemplateFiles($root));
$run([$php, 'bin/console', 'lint:yaml', '--parse-tags', 'config', 'translations'], 'YAML config and translations');
$failures += lintSourceFiles($root, filesWithExtensions($root, ['js']), new JavaScriptLinter(), 'JavaScript module syntax');
$failures += lintSourceFiles($root, filesWithExtensions($root, ['json']), new JsonLinter(), 'JSON syntax');
$failures += lintMarkdownFiles($root, filesWithExtensions($root, ['md']));
$run([$php, 'bin/console', 'tailwind:build'], 'Tailwind CSS build');
$failures += lintTranslationSourceKeys($root);
$failures += lintGitDiffWhitespace($root, null);

if (0 !== $failures) {
    fwrite(STDERR, sprintf("\nLint failed with %d failing check(s).\n", $failures));

    exit(1);
}

fwrite(STDOUT, "\nAll lint checks passed.\n");
