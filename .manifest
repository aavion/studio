# Update-features use this manifest to check for new updates for the specified channel.
# You may alter the source repository (MANIFEST_SOURCE), if you use a different fork.
# MANIFEST_CHANNEL defines the target branch inside the specified repository.

##> aavion/studio manifest ###
MANIFEST_VERSION=0.0.0
MANIFEST_DATE=2026-05-19
MANIFEST_CHANNEL=dev-latest
MANIFEST_SOURCE=https://github.com/aavion/studio.git
###< aavion/studio manifest ###