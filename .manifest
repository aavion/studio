# Update-features use this manifest to check for new updates for the specified channel.
# You may alter the source repository (STUDIO_SOURCE), if you use a different fork.
# STUDIO_CHANNEL defines the target branch inside the specified repository.

##> aavion/studio manifest ###
STUDIO_VERSION=0.0.0
STUDIO_CHANNEL=dev-latest
STUDIO_SOURCE=https://github.com/aavion/studio.git
###< aavion/studio manifest ###