{% extends '@backend/setup.html.twig' %}

{% block title %}{{ 'setup.dashboard.title'|trans }}{% endblock %}

{% block setup_body %}
    {% include '@backend/setup/partials/_alerts.html.twig' with {
        setup_database_test: setup_database_test,
        setup_errors: setup_errors,
    } only %}

    {% if setup_step != 'language' %}
        {% set step_icon = {
            site: 'ti-adjustments',
            database: 'ti-database',
            admin: 'ti-shield-check',
            review: 'ti-list-check',
            result: 'ti-circle-check',
        }[setup_step]|default('ti-rocket') %}
        {% include '@backend/setup/partials/_step-header.html.twig' with {
            eyebrow: 'setup.header.eyebrow'|trans({'%app_name%': setup_app_name}),
            title: ('setup.step_title.' ~ setup_step)|trans,
            subtitle: ('setup.step_intro.' ~ setup_step)|trans,
            icon: step_icon,
        } only %}
    {% endif %}

    <form
        id="setup-wizard"
        class="system-backend-form system-backend-setup-wizard{{ setup_step == 'language' ? ' is-landing' : '' }}"
        method="post"
        action="{{ setup_step == 'language' ? path('backend_setup_index') : path('backend_setup_step', {step: setup_step}) }}"
        data-controller="setup-wizard{% if setup_step == 'admin' %} password-policy{% endif %}{{ setup_step == 'review' ? ' operation-overlay' : '' }}"
        {% if setup_step == 'review' %}data-action="submit->operation-overlay#submit"{% endif %}
        {% if setup_step == 'admin' %}
            data-password-policy-username-value="{{ setup_values.admin_username }}"
            data-password-policy-email-value="{{ setup_values.admin_email }}"
            data-password-policy-mismatch-message-value="{{ 'ui.user.password.errors.password_mismatch'|trans }}"
        {% endif %}
        {% if setup_step == 'review' %}
            data-operation-overlay-enabled-value="true"
            data-operation-overlay-redirect-on-success-value="/"
        {% endif %}
        data-turbo="false"
    >
        <input type="hidden" name="_form_id" value="setup-wizard-{{ setup_step }}{{ setup_step == 'review' ? '-live-v2' : '' }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('setup-wizard') }}">
        <input type="hidden" name="_setup_action" value="">

        {% if setup_step == 'language' %}
            {% include '@backend/setup/partials/steps/_language.html.twig' with {
                setup_app_name: setup_app_name,
                setup_available_languages: setup_available_languages,
                setup_display_values: setup_display_values,
                setup_errors: setup_errors,
                setup_preflight: setup_preflight,
            } only %}
        {% elseif setup_step == 'site' %}
            {% include '@backend/setup/partials/steps/_site.html.twig' with {
                setup_display_values: setup_display_values,
                setup_errors: setup_errors,
                setup_site_settings_form: setup_site_settings_form,
                form_id: 'setup-wizard',
            } only %}
        {% elseif setup_step == 'database' %}
            {% include '@backend/setup/partials/steps/_database.html.twig' with {
                setup_database_driver_options: setup_database_driver_options,
                setup_display_values: setup_display_values,
                setup_errors: setup_errors,
            } only %}
        {% elseif setup_step == 'admin' %}
            {% include '@backend/setup/partials/steps/_admin.html.twig' with {
                setup_display_values: setup_display_values,
                setup_errors: setup_errors,
                setup_min_app_secret_length: setup_min_app_secret_length,
                setup_values: setup_values,
            } only %}
        {% elseif setup_step == 'review' %}
            {% include '@backend/setup/partials/steps/_review.html.twig' with {setup_values: setup_values} only %}
        {% elseif setup_step == 'result' %}
            {% include '@backend/setup/partials/steps/_result.html.twig' with {setup_workflow: setup_workflow} only %}
        {% endif %}

        {% include '@backend/setup/partials/_footer.html.twig' with {
            setup_completed_steps: setup_completed_steps,
            setup_previous_step: setup_previous_step,
            setup_step: setup_step,
            setup_steps: setup_steps,
        } only %}
    </form>

    {% if setup_step == 'result' and setup_workflow %}
        {% include '@backend/setup/partials/_result_log.html.twig' with {
            setup_action_log: setup_action_log,
            setup_workflow: setup_workflow,
        } only %}
    {% endif %}
{% endblock %}
