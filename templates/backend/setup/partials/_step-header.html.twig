<header class="system-backend-setup-step-header">
    <span class="system-backend-setup-landing-icon ti {{ icon|default('ti-rocket') }}" aria-hidden="true"></span>
    <div class="system-backend-setup-landing-kicker">{{ eyebrow|default('ui.setup.area'|trans) }}</div>
    <h1>{{ title }}</h1>
    {% if subtitle is defined and subtitle is not empty %}
        <p>{{ subtitle }}</p>
    {% endif %}
</header>
