{% extends '@backend/admin.html.twig' %}

{% block title %}{{ 'admin.logs.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'ui.admin.area'|trans,
        title: 'admin.logs.title'|trans,
    } only %}

    <section class="studio-panel">
        <h2>{{ 'admin.logs.filters.title'|trans }}</h2>
        <form method="get" class="studio-form studio-log-filter-form">
            <div class="studio-form-grid">
                <label>
                    <span>{{ 'admin.logs.filters.source'|trans }}</span>
                    <select name="source">
                        {% for source in log_view.sources %}
                            <option value="{{ source.key }}" {% if source.key == log_view.selected_source %}selected{% endif %}>{{ source.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.logs.filters.window'|trans }}</span>
                    <select name="time_window">
                        {% for window in log_view.time_window_options %}
                            <option value="{{ window.key }}" {% if window.key == log_view.filters.time_window %}selected{% endif %}>{{ window.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.logs.filters.level'|trans }}</span>
                    <select name="level">
                        <option value="">{{ 'admin.logs.filters.any_level'|trans }}</option>
                        {% for level in ['DEBUG', 'INFO', 'NOTICE', 'WARNING', 'ERROR', 'CRITICAL', 'ALERT', 'EMERGENCY'] %}
                            <option value="{{ level }}" {% if level == log_view.filters.level %}selected{% endif %}>{{ level }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.logs.filters.search'|trans }}</span>
                    <input type="search" name="q" value="{{ log_view.filters.search }}" maxlength="120">
                </label>
                <label>
                    <span>{{ 'admin.logs.filters.match'|trans }}</span>
                    <select name="match">
                        {% for match in log_view.match_options %}
                            <option value="{{ match.key }}" {% if match.key == log_view.filters.match %}selected{% endif %}>{{ match.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.logs.filters.audit_action'|trans }}</span>
                    <input type="search" name="audit_action" value="{{ log_view.filters.audit_action }}" maxlength="120">
                </label>
                <label>
                    <span>{{ 'admin.logs.filters.per_page'|trans }}</span>
                    <select name="per_page">
                        {% for option in log_view.per_page_options %}
                            <option value="{{ option.key }}" {% if option.key == log_view.filters.per_page %}selected{% endif %}>{{ option.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <input type="hidden" name="page" value="1">
            <button type="submit" class="studio-button">{{ 'admin.logs.filters.apply'|trans }}</button>
        </form>
    </section>

    <section class="studio-panel">
        <h2>{{ 'admin.logs.entries.title'|trans }}</h2>
        {% if log_view.files is empty %}
            <p class="studio-muted">{{ 'admin.logs.entries.no_files'|trans }}</p>
        {% elseif log_view.entries is empty %}
            <p class="studio-muted">{{ 'admin.logs.entries.empty'|trans }}</p>
        {% else %}
            <p class="studio-muted">{{ 'admin.logs.entries.files'|trans({'%files%': log_view.files|join(', ')}) }}</p>
            <div class="studio-table-wrapper">
                <table class="studio-table studio-log-table">
                    <thead>
                        <tr>
                            <th>{{ 'admin.logs.columns.timestamp'|trans }}</th>
                            <th>{{ 'admin.logs.columns.level'|trans }}</th>
                            {% if log_view.selected_source == 'access' %}
                                <th>{{ 'admin.logs.columns.request'|trans }}</th>
                                <th>{{ 'admin.logs.columns.http_status'|trans }}</th>
                            {% elseif log_view.selected_source == 'audit' %}
                                <th>{{ 'admin.logs.columns.user'|trans }}</th>
                                <th>{{ 'admin.logs.columns.action'|trans }}</th>
                            {% else %}
                                <th>{{ 'admin.logs.columns.message'|trans }}</th>
                            {% endif %}
                            <th>{{ 'admin.logs.columns.details'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in log_view.entries %}
                            <tr>
                                <td>{{ entry.timestamp|default('') }}</td>
                                <td><span class="studio-badge">{{ entry.level|default('') }}</span></td>
                                {% if log_view.selected_source == 'access' %}
                                    <td>{{ entry.context.method|default('admin.logs.empty_value'|trans) }} {{ entry.context.requested_path|default(entry.context.path|default('admin.logs.empty_value'|trans)) }}<br><span class="studio-muted">{{ entry.context.resolved_route|default(entry.context.route|default('admin.logs.empty_value'|trans)) }}</span></td>
                                    <td>{{ entry.context.http_status|default('admin.logs.empty_value'|trans) }}</td>
                                {% elseif log_view.selected_source == 'audit' %}
                                    <td>{{ entry.context.user|default('admin.logs.empty_value'|trans) }}<br><span class="studio-muted">{{ entry.context.user_access_level|default('0') }}</span></td>
                                    <td>{{ entry.context.action|default(entry.message) }}</td>
                                {% else %}
                                    <td>{{ entry.summary|default(entry.message|default(entry.raw)) }}</td>
                                {% endif %}
                                <td><a href="{{ path('backend_admin_log_detail', {entryId: entry.id, source: log_view.selected_source}) }}">{{ 'admin.logs.entries.open'|trans }}</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="studio-toolbar">
                <span class="studio-muted">{{ 'admin.logs.entries.page_summary'|trans({'%page%': log_view.pagination.page, '%pages%': log_view.pagination.total_pages, '%total%': log_view.pagination.total}) }}</span>
                {% if log_view.pagination.has_previous %}
                    <a class="studio-button" href="?{{ app.request.query.all|merge({page: log_view.pagination.previous_page})|url_encode }}">{{ 'admin.logs.entries.previous'|trans }}</a>
                {% endif %}
                {% if log_view.pagination.has_next %}
                    <a class="studio-button" href="?{{ app.request.query.all|merge({page: log_view.pagination.next_page})|url_encode }}">{{ 'admin.logs.entries.next'|trans }}</a>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}
