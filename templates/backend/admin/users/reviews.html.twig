{% extends '@backend/admin.html.twig' %}

{% block title %}{{ 'admin.user_reviews.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.users.title'|trans,
        title: 'admin.user_reviews.title'|trans,
        subtitle: 'admin.user_reviews.subtitle'|trans,
    } only %}

    <nav class="system-tabs" aria-label="{{ 'admin.user_reviews.filters.label'|trans }}">
        {% for filter in review_filters %}
            <a class="system-tab{% if review_filter == filter %} system-tab-active{% endif %}" href="{{ path('backend_admin_user_reviews', app.request.query.all|merge({filter: filter, page: 1})) }}">
                {{ ('admin.user_reviews.filters.' ~ filter)|trans }}
            </a>
        {% endfor %}
    </nav>

    <section class="system-panel">
        <h2>{{ 'admin.user_reviews.filters.title'|trans }}</h2>
        <form method="get" class="system-form system-backend-log-filter-form" data-controller="filter-form" data-action="input->filter-form#queue change->filter-form#queue submit->filter-form#submit">
            <input type="hidden" name="filter" value="{{ review_filter == 'all' ? '' : review_filter }}">
            <div class="system-form-grid">
                <label>
                    <span>{{ 'admin.user_reviews.filters.search'|trans }}</span>
                    <input type="search" name="q" value="{{ review_view.filters.search }}" maxlength="120">
                </label>
                <label>
                    <span>{{ 'admin.user_reviews.filters.sort'|trans }}</span>
                    <select name="sort">
                        {% for option in review_view.sort_options %}
                            <option value="{{ option.key }}" {% if option.key == review_view.filters.sort %}selected{% endif %}>{{ option.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.user_reviews.filters.direction'|trans }}</span>
                    <select name="direction">
                        <option value="asc" {% if review_view.filters.direction == 'asc' %}selected{% endif %}>{{ 'admin.user_reviews.filters.asc'|trans }}</option>
                        <option value="desc" {% if review_view.filters.direction == 'desc' %}selected{% endif %}>{{ 'admin.user_reviews.filters.desc'|trans }}</option>
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.user_reviews.filters.per_page'|trans }}</span>
                    <select name="per_page">
                        {% for option in review_view.per_page_options %}
                            <option value="{{ option.key }}" {% if option.key == review_view.filters.per_page %}selected{% endif %}>{{ option.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <input type="hidden" name="page" value="1">
            <button type="submit" class="system-button">{{ 'admin.user_reviews.filters.apply'|trans }}</button>
        </form>
    </section>

    <section class="system-panel">
        {% if review_items is empty %}
            {% include '@backend/partials/feedback/_empty-state.html.twig' with {
                title: 'admin.user_reviews.empty_title'|trans,
                message: 'admin.user_reviews.empty_message'|trans,
            } only %}
        {% else %}
            <div class="system-backend-review-list">
                {% for item in review_items %}
                    {% set token = item.token %}
                    {% set user = item.user %}
                    <article class="system-backend-review-row">
                        <div class="system-backend-review-main">
                            <div class="system-backend-review-badges">
                                <span class="system-badge">{{ ('admin.user_reviews.kind.' ~ item.kind)|trans }}</span>
                                <span class="system-badge">{{ ('admin.user_reviews.status.' ~ item.status)|trans }}</span>
                            </div>
                            <h2>
                                {% if user %}
                                    {{ user.username }}
                                    <span class="system-muted">{{ user.email }}</span>
                                {% else %}
                                    {{ item.email }}
                                {% endif %}
                            </h2>
                            <p class="system-muted">
                                {{ 'admin.user_reviews.requested_at'|trans({'%datetime%': item.requested_at|date('Y-m-d H:i')}) }}
                                {% if item.role is defined %}
                                    · {{ 'admin.user_reviews.role'|trans({'%role%': ('admin.users.roles.' ~ item.role)|trans}) }}
                                {% endif %}
                                {% if item.groups is not empty %}
                                    · {{ 'admin.user_reviews.groups'|trans({'%groups%': item.groups|join(', ')}) }}
                                {% endif %}
                            </p>
                        </div>

                        <div class="system-backend-review-actions">
                            {% if item.kind == 'registration_approval' %}
                                <form method="post" action="{{ path('backend_admin_user_invitation_approve', {uid: token.uid}) }}" class="system-inline-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_token_' ~ token.uid) }}">
                                    <input type="hidden" name="return_to" value="reviews">
                                    <button class="system-button" type="submit"{% if not reviews_mutable %} disabled{% endif %}>{{ 'admin.user_reviews.actions.accept'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('backend_admin_user_invitation_revoke', {uid: token.uid}) }}" class="system-inline-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_token_' ~ token.uid) }}">
                                    <input type="hidden" name="return_to" value="reviews">
                                    <button class="system-button system-button-secondary" type="submit"{% if not reviews_mutable %} disabled{% endif %}>{{ 'admin.user_reviews.actions.reject'|trans }}</button>
                                </form>
                            {% elseif item.kind in ['invitation', 'registration'] %}
                                <form method="post" action="{{ path('backend_admin_user_invitation_reissue', {uid: token.uid}) }}" class="system-inline-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_token_' ~ token.uid) }}">
                                    <input type="hidden" name="return_to" value="reviews">
                                    <button class="system-button" type="submit"{% if not reviews_mutable %} disabled{% endif %}>{{ 'admin.user_reviews.actions.reissue'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('backend_admin_user_invitation_revoke', {uid: token.uid}) }}" class="system-inline-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_token_' ~ token.uid) }}">
                                    <input type="hidden" name="return_to" value="reviews">
                                    <button class="system-button system-button-secondary" type="submit"{% if not reviews_mutable %} disabled{% endif %}>{{ 'admin.user_reviews.actions.delete'|trans }}</button>
                                </form>
                            {% elseif item.kind == 'password_dispute' and user %}
                                <form method="post" action="{{ path('backend_admin_user_review_reactivate', {username: user.username}) }}" class="system-inline-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_review_' ~ user.username) }}">
                                    <button class="system-button" type="submit"{% if not reviews_mutable %} disabled{% endif %}>{{ 'admin.user_reviews.actions.reactivate'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('backend_admin_user_review_delete', {username: user.username}) }}" class="system-inline-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_review_' ~ user.username) }}">
                                    <label class="system-muted">
                                        <input type="checkbox" name="confirm_delete" value="1"{% if not reviews_mutable %} disabled{% endif %}>
                                        {{ 'admin.user_reviews.actions.confirm_delete'|trans }}
                                    </label>
                                    <button class="system-button system-button-secondary" type="submit"{% if not reviews_mutable %} disabled{% endif %}>{{ 'admin.user_reviews.actions.delete'|trans }}</button>
                                </form>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
            <div class="system-toolbar">
                <span class="system-muted">{{ 'admin.user_reviews.pagination.page_summary'|trans({'%page%': review_view.pagination.page, '%pages%': review_view.pagination.total_pages, '%total%': review_view.pagination.total}) }}</span>
                {% if review_view.pagination.has_previous %}
                    <a class="system-button" href="?{{ app.request.query.all|merge({page: review_view.pagination.previous_page})|url_encode }}">{{ 'admin.user_reviews.pagination.previous'|trans }}</a>
                {% endif %}
                {% if review_view.pagination.has_next %}
                    <a class="system-button" href="?{{ app.request.query.all|merge({page: review_view.pagination.next_page})|url_encode }}">{{ 'admin.user_reviews.pagination.next'|trans }}</a>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}
