{% extends '@backend/admin.html.twig' %}

{% block title %}{{ user_account.username }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.users.title'|trans,
        title: user_account.username,
    } only %}

    <section class="system-panel">
        <h2>{{ 'admin.users.detail.title'|trans }}</h2>
        <dl class="system-backend-summary">
            <div>
                <dt>{{ 'admin.users.fields.uid'|trans }}</dt>
                <dd>{{ user_account.uid }}</dd>
            </div>
            <div>
                <dt>{{ 'admin.users.fields.email'|trans }}</dt>
                <dd>{{ user_account.email }}</dd>
            </div>
            <div>
                <dt>{{ 'admin.users.fields.role'|trans }}</dt>
                <dd>{{ ('admin.users.roles.' ~ user_account.role.value)|trans }}</dd>
            </div>
            <div>
                <dt>{{ 'admin.users.fields.login_possible'|trans }}</dt>
                <dd>{{ login_possible ? 'ui.form.yes'|trans : 'ui.form.no'|trans }}</dd>
            </div>
        </dl>
        <form method="post" class="system-backend-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_' ~ user_account.username) }}">
            {% include '@backend/partials/forms/fields/select.html.twig' with {
                id: 'user_role',
                name: 'role',
                label: 'admin.users.fields.role'|trans,
                value: user_account.role.value,
                options: role_options|reduce((carry, role) => carry|merge({(role.value): ('admin.users.roles.' ~ role.value)|trans}), {}),
                required: true,
                disabled: not users_mutable,
            } only %}
            {% include '@backend/partials/forms/fields/select.html.twig' with {
                id: 'user_status',
                name: 'status',
                label: 'admin.users.fields.status'|trans,
                value: user_account.status.value,
                options: {
                    active: 'admin.users.status.active'|trans,
                    inactive: 'admin.users.status.inactive'|trans,
                    deleted: 'admin.users.status.deleted'|trans,
                },
                required: true,
                disabled: not users_mutable,
            } only %}
            {% include '@backend/partials/forms/fields/checkbox-group.html.twig' with {
                id: 'user_groups',
                name: 'groups',
                label: 'admin.users.fields.groups'|trans,
                values: user_account.groups|map(group => group.identifier),
                options: groups|reduce((carry, group) => carry|merge({(group.identifier): group.name}), {}),
                disabled: not users_mutable,
            } only %}
            {% include '@backend/partials/forms/fields/submit.html.twig' with {label: 'admin.users.actions.save'|trans, disabled: not users_mutable} only %}
        </form>
    </section>

    <section class="system-panel">
        <h2>{{ 'admin.users.password_reset.title'|trans }}</h2>
        <p class="system-muted">{{ 'admin.users.password_reset.text'|trans }}</p>
        <form method="post" action="{{ path('backend_admin_user_password_reset', {username: user_account.username}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_password_reset_' ~ user_account.username) }}">
            <button class="system-button" type="submit"{% if not users_mutable %} disabled{% endif %}>{{ 'admin.users.password_reset.submit'|trans }}</button>
        </form>
    </section>

    <section class="system-panel">
        <h2>{{ 'admin.users.history.title'|trans }}</h2>
        <p><a href="{{ audit_log_url }}">{{ 'admin.users.history.audit_link'|trans }}</a></p>
        {% if state_history is empty %}
            <p class="system-muted">{{ 'admin.users.history.empty'|trans }}</p>
        {% else %}
            <table class="system-field-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'admin.users.history.fields.event'|trans }}</th>
                        <th scope="col">{{ 'admin.users.history.fields.at'|trans }}</th>
                        <th scope="col">{{ 'admin.users.history.fields.by'|trans }}</th>
                        <th scope="col">{{ 'admin.users.history.fields.value'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for marker in state_history %}
                        <tr>
                            <td>{{ ('admin.users.history.marker.' ~ marker.marker_key)|trans }}</td>
                            <td>{{ marker.marker_at|date('Y-m-d H:i') }}</td>
                            <td>{{ marker.marker_by|default('admin.logs.empty_value'|trans) }}</td>
                            <td>{{ marker.marker_value|default('admin.logs.empty_value'|trans) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
