{% extends '@backend/admin.html.twig' %}

{% block title %}{{ 'admin.groups.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.users.title'|trans,
        title: 'admin.groups.title'|trans,
    } only %}

    <section class="studio-panel">
        <h2>{{ 'admin.groups.create.title'|trans }}</h2>
        <form method="post" class="studio-backend-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_group_create') }}">
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_identifier', name: 'identifier', label: 'admin.groups.fields.identifier'|trans, required: true} only %}
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_name_en', name: 'name_en', label: 'admin.groups.fields.name_en'|trans, required: true} only %}
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_name_de', name: 'name_de', label: 'admin.groups.fields.name_de'|trans} only %}
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_access_level', name: 'access_level', label: 'admin.groups.fields.access_level'|trans, type: 'number', required: true, attributes: {min: 1, max: 9}} only %}
            {% include '@backend/partials/forms/fields/submit.html.twig' with {label: 'admin.groups.actions.create'|trans} only %}
        </form>
    </section>

    <section class="studio-panel">
        <h2>{{ 'admin.groups.list.title'|trans }}</h2>
        <table class="studio-field-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'admin.groups.fields.identifier'|trans }}</th>
                    <th scope="col">{{ 'admin.groups.fields.name'|trans }}</th>
                    <th scope="col">{{ 'admin.groups.fields.access_level'|trans }}</th>
                    <th scope="col">{{ 'admin.groups.fields.locked'|trans }}</th>
                    <th scope="col">{{ 'admin.users.fields.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for group in groups %}
                    <tr>
                        <td>{{ group.identifier }}</td>
                        <td>{{ group.name.en|default(group.identifier) }}</td>
                        <td>{{ group.accessLevel }}</td>
                        <td>{{ group.locked ? 'ui.form.yes'|trans : 'ui.form.no'|trans }}</td>
                        <td><a href="{{ path('backend_admin_user_group_detail', {uid: group.uid}) }}">{{ 'admin.users.actions.details'|trans }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
