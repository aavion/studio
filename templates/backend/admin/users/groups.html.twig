{% extends '@backend/admin.html.twig' %}

{% block title %}{{ 'admin.groups.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.users.title'|trans,
        title: 'admin.groups.title'|trans,
    } only %}

    <section class="studio-panel">
        <h2>{{ 'admin.groups.create.title'|trans }}</h2>
        <form method="post" class="studio-backend-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_group_create') }}">
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_identifier', name: 'identifier', label: 'admin.groups.fields.identifier'|trans, required: true} only %}
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_name', name: 'name', label: 'admin.groups.fields.name'|trans, required: true, attributes: {maxlength: 160}} only %}
            {% include '@backend/partials/forms/fields/input.html.twig' with {id: 'group_min_role', name: 'min_role', label: 'admin.groups.fields.min_role'|trans, type: 'number', required: true, attributes: {min: 0, max: 9}} only %}
            {% include '@backend/partials/forms/fields/submit.html.twig' with {label: 'admin.groups.actions.create'|trans} only %}
        </form>
    </section>

    <section class="studio-panel">
        <h2>{{ 'admin.groups.list.title'|trans }}</h2>
        <form method="get" class="studio-form studio-log-filter-form">
            <div class="studio-form-grid">
                <label>
                    <span>{{ 'admin.groups.filters.search'|trans }}</span>
                    <input type="search" name="q" value="{{ groups_view.filters.search }}" maxlength="120">
                </label>
                <label>
                    <span>{{ 'admin.groups.filters.sort'|trans }}</span>
                    <select name="sort">
                        {% for option in groups_view.sort_options %}
                            <option value="{{ option.key }}" {% if option.key == groups_view.filters.sort %}selected{% endif %}>{{ option.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.groups.filters.direction'|trans }}</span>
                    <select name="direction">
                        <option value="asc" {% if groups_view.filters.direction == 'asc' %}selected{% endif %}>{{ 'admin.groups.filters.asc'|trans }}</option>
                        <option value="desc" {% if groups_view.filters.direction == 'desc' %}selected{% endif %}>{{ 'admin.groups.filters.desc'|trans }}</option>
                    </select>
                </label>
                <label>
                    <span>{{ 'admin.groups.filters.per_page'|trans }}</span>
                    <select name="per_page">
                        {% for option in groups_view.per_page_options %}
                            <option value="{{ option.key }}" {% if option.key == groups_view.filters.per_page %}selected{% endif %}>{{ option.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <input type="hidden" name="page" value="1">
            <button type="submit" class="studio-button">{{ 'admin.groups.filters.apply'|trans }}</button>
        </form>
        <table class="studio-field-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'admin.groups.fields.identifier'|trans }}</th>
                    <th scope="col">{{ 'admin.groups.fields.name'|trans }}</th>
                    <th scope="col">{{ 'admin.groups.fields.min_role'|trans }}</th>
                    <th scope="col">{{ 'admin.users.fields.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for group in groups %}
                    <tr>
                        <td>{{ group.identifier }}</td>
                        <td>{{ group.name }}</td>
                        <td>{{ group.minRole }}</td>
                        <td><a href="{{ path('backend_admin_user_group_detail', {uid: group.uid}) }}">{{ 'admin.users.actions.details'|trans }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="studio-toolbar">
            <span class="studio-muted">{{ 'admin.groups.pagination.page_summary'|trans({'%page%': groups_view.pagination.page, '%pages%': groups_view.pagination.total_pages, '%total%': groups_view.pagination.total}) }}</span>
            {% if groups_view.pagination.has_previous %}
                <a class="studio-button" href="?{{ app.request.query.all|merge({page: groups_view.pagination.previous_page})|url_encode }}">{{ 'admin.groups.pagination.previous'|trans }}</a>
            {% endif %}
            {% if groups_view.pagination.has_next %}
                <a class="studio-button" href="?{{ app.request.query.all|merge({page: groups_view.pagination.next_page})|url_encode }}">{{ 'admin.groups.pagination.next'|trans }}</a>
            {% endif %}
        </div>
    </section>
{% endblock %}
