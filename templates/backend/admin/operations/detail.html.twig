{% extends '@backend/admin.html.twig' %}

{% set report = operation_report %}
{% set progress = report.progress|default({}) %}

{% block title %}{{ 'admin.operations.detail.title'|trans({'%operation%': report.label ?: report.operation}) }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.operations.title'|trans,
        title: report.label ?: report.operation,
    } only %}

    <section class="studio-panel">
        <h2>{{ 'admin.operations.detail.overview'|trans }}</h2>
        <dl class="studio-definition-list">
            <div>
                <dt>{{ 'admin.operations.table.status'|trans }}</dt>
                <dd>
                    <span class="studio-badge studio-badge-{{ report.status == 'success' ? 'success' : (report.status == 'failed' ? 'error' : (report.status == 'requires_review' ? 'warning' : 'neutral')) }}">
                        {{ ('ui.operations.action_log.statuses.' ~ report.status)|trans }}
                    </span>
                </dd>
            </div>
            <div>
                <dt>{{ 'admin.operations.table.progress'|trans }}</dt>
                <dd>{{ progress.index|default(0) }}/{{ progress.total|default(0) }}</dd>
            </div>
            <div>
                <dt>{{ 'admin.operations.detail.created_at'|trans }}</dt>
                <dd>{{ report.created_at|default('admin.operations.unknown_value'|trans) }}</dd>
            </div>
            <div>
                <dt>{{ 'admin.operations.table.updated_at'|trans }}</dt>
                <dd>{{ report.updated_at|default('admin.operations.unknown_value'|trans) }}</dd>
            </div>
            <div>
                <dt>{{ 'admin.operations.detail.operation_id'|trans }}</dt>
                <dd><code>{{ report.operation_id }}</code></dd>
            </div>
            <div>
                <dt>{{ 'admin.operations.detail.operation_key'|trans }}</dt>
                <dd><code>{{ report.operation }}</code></dd>
            </div>
        </dl>
    </section>

    <section class="studio-panel">
        <h2>{{ 'admin.operations.detail.entries'|trans }}</h2>
        {% if report.entries is not empty %}
            <ol class="studio-action-log-list">
                {% for entry in report.entries %}
                    <li class="studio-action-log-entry">
                        <strong>[{{ entry.index }}/{{ entry.total }}] {{ entry.name }}</strong>
                        <span class="studio-badge studio-badge-{{ entry.status == 'success' ? 'success' : (entry.status == 'failed' ? 'error' : (entry.status == 'warning' ? 'warning' : 'neutral')) }}">
                            {{ ('ui.operations.action_log.statuses.' ~ entry.status)|trans }}
                        </span>
                        {% for issue in entry.issues %}
                            <p>{{ issue.translation_key ? issue.translation_key|trans(issue.parameters) : issue.code }}</p>
                        {% endfor %}
                        {% for message in entry.messages %}
                            <p>{{ message.translation_key ? message.translation_key|trans(message.parameters) : message.code }}</p>
                        {% endfor %}
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <p class="studio-muted">{{ 'admin.operations.detail.entries_empty'|trans }}</p>
        {% endif %}
    </section>

    {% if report.result %}
        <section class="studio-panel">
            <h2>{{ 'admin.operations.detail.result'|trans }}</h2>
            {% for issue in report.result.issues %}
                <p class="studio-alert studio-alert-warning">{{ issue.translation_key ? issue.translation_key|trans(issue.parameters) : issue.code }}</p>
            {% endfor %}
            {% for message in report.result.messages %}
                <p class="studio-alert studio-alert-info">{{ message.translation_key ? message.translation_key|trans(message.parameters) : message.code }}</p>
            {% endfor %}
            {% if report.result.issues is empty and report.result.messages is empty %}
                <p class="studio-muted">{{ 'admin.operations.detail.result_empty'|trans }}</p>
            {% endif %}
            {% if report.result.can_continue|default(false) %}
                <form method="post" action="/admin/operations/{{ report.operation_id }}/continue">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin-operations') }}">
                    <button class="studio-backend-button studio-button-primary" type="submit">
                        {{ 'admin.operations.actions.continue'|trans }}
                    </button>
                </form>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
