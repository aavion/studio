{% extends '@backend/admin.html.twig' %}

{% block title %}{{ 'admin.dashboard.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'ui.admin.area'|trans,
        title: 'admin.dashboard.title'|trans,
    } only %}

    {% include '@backend/partials/feedback/_message.html.twig' with {message: message} only %}

    <section class="system-panel">
        <h2>{{ 'admin.dashboard.foundation_title'|trans }}</h2>
        <p class="system-muted">{{ 'admin.dashboard.foundation_text'|trans }}</p>
    </section>
{% endblock %}
