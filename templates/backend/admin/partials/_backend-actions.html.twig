{% if actions|default([]) is not empty %}
    <div class="system-backend-button-group {{ class|default('') }}">
        {% for action in actions %}
            <form
                method="post"
                action="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}"
                {% if action.live %}
                    data-controller="operation-overlay"
                    data-action="submit->operation-overlay#submit"
                    data-operation-overlay-enabled-value="true"
                {% endif %}
            >
                <input type="hidden" name="_form_id" value="backend-action-{{ action.id }}">
                <input type="hidden" name="_backend_action" value="{{ action.id }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('backend-action-' ~ action.id) }}">
                <button class="system-backend-button system-button-{{ action.variant }}" type="submit"{% if action.disabled|default(false) %} disabled{% endif %}>
                    {{ action.label_key|trans }}
                </button>
            </form>
        {% endfor %}
    </div>
{% endif %}
