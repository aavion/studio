{% if rows is empty %}
    <p class="system-muted">{{ 'admin.statistics.empty'|trans }}</p>
{% else %}
    <ol class="system-backend-stat-list">
        {% for row in rows %}
            <li><span>{{ row.label }}</span> <strong>{{ row.count }}</strong></li>
        {% endfor %}
    </ol>
{% endif %}
