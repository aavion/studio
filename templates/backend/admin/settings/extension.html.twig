{% extends '@backend/admin.html.twig' %}

{% set extension_name = view.context.extension_name|default('') %}
{% set extension_settings = extension_settings(extension_name) %}
{% set extension_form = extension_settings_form(extension_name) %}

{% block title %}{{ 'admin.settings.extension.title'|trans({'%extension%': view.label|default(extension_name)}) }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.settings.title'|trans,
        title: 'admin.settings.extension.title'|trans({'%extension%': view.label|default(extension_name)}),
    } only %}

    {% if view.context.description|default(null) %}
        <p class="system-muted">{{ view.context.description }}</p>
    {% endif %}

    <section class="system-panel">
        <h2>{{ 'admin.settings.extension.foundation_title'|trans }}</h2>
        {% include '@backend/partials/forms/_dynamic.html.twig' with {form: extension_form} only %}
        {% if extension_settings|length > 0 %}
            <dl>
                {% for setting in extension_settings %}
                    <dt>{{ setting.label|trans }}</dt>
                    <dd>
                        <code>{{ setting.key }}</code>
                        <span class="system-muted">{{ setting.type }}</span>
                        <span class="system-muted">{{ setting.input_type }}</span>
                        {% if setting.description %}
                            <p class="system-muted">{{ setting.description|trans }}</p>
                        {% endif %}
                        {% if setting.options|length > 0 %}
                            <p class="system-muted">{{ 'admin.settings.extension.options'|trans({'%count%': setting.options|length}) }}</p>
                        {% endif %}
                        {% if setting.validation|length > 0 %}
                            <p class="system-muted">{{ 'admin.settings.extension.validation'|trans({'%count%': setting.validation|length}) }}</p>
                        {% endif %}
                    </dd>
                {% endfor %}
            </dl>
        {% else %}
            <p class="system-muted">{{ 'admin.settings.extension.empty'|trans }}</p>
        {% endif %}
    </section>
{% endblock %}
