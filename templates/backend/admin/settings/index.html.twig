{% extends '@backend/admin.html.twig' %}

{% block title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'ui.admin.area'|trans,
        title: 'admin.settings.title'|trans,
    } only %}

    <section class="studio-panel">
        <h2>{{ 'admin.settings.redirect_title'|trans }}</h2>
        <p class="studio-muted">{{ 'admin.settings.redirect_text'|trans }}</p>
        <p><a href="{{ path('backend_admin_route', {path: 'settings/global'}) }}">{{ 'admin.settings.global.title'|trans }}</a></p>
    </section>
{% endblock %}
