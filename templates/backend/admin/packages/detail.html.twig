{% extends '@backend/admin.html.twig' %}

{% block title %}{{ package.label }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% set package_actions %}
        {% if package.actions is not empty %}
            <div class="studio-backend-button-group">
                {% for action in package.actions %}
                    <a class="studio-backend-button studio-button-{{ action.variant }}" href="{{ action.path }}">
                        {{ action.label_key|trans }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    {% endset %}

    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.packages.title'|trans,
        title: package.label,
        actions: package_actions,
    } only %}

    {% if package.preview_image %}
        <figure class="studio-package-hero">
            <img src="{{ package.preview_image }}" alt="">
        </figure>
    {% endif %}

    <section class="studio-panel">
        <h2>{{ 'admin.packages.detail.overview_title'|trans }}</h2>
        <table class="studio-table">
            <tbody>
                <tr>
                    <th scope="row">{{ 'admin.packages.table.status'|trans }}</th>
                    <td>
                        <span class="studio-badge studio-badge-{{ package.status_tone }}">{{ package.status_label_key|trans }}</span>
                        {% if package.immutable %}
                            <span class="studio-badge studio-badge-info">{{ 'admin.packages.detail.immutable'|trans }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th scope="row">{{ 'admin.packages.table.scopes'|trans }}</th>
                    <td>
                        {% for scope in package.scopes %}
                            <span class="studio-badge studio-badge-neutral">{{ scope.label_key|trans }}</span>
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <th scope="row">{{ 'admin.packages.table.version'|trans }}</th>
                    <td>{{ package.installed_version|default(package.manifest_version|default('admin.packages.unknown_value'|trans)) }}</td>
                </tr>
                <tr>
                    <th scope="row">{{ 'admin.packages.table.path'|trans }}</th>
                    <td><code>{{ package.path }}</code></td>
                </tr>
                {% if package.description %}
                    <tr>
                        <th scope="row">{{ 'admin.packages.detail.description'|trans }}</th>
                        <td>{{ package.description }}</td>
                    </tr>
                {% endif %}
                {% if package.author %}
                    <tr>
                        <th scope="row">{{ 'admin.packages.detail.author'|trans }}</th>
                        <td>{{ package.author }}</td>
                    </tr>
                {% endif %}
                {% if package.license %}
                    <tr>
                        <th scope="row">{{ 'admin.packages.detail.license'|trans }}</th>
                        <td>{{ package.license }}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th scope="row">{{ 'admin.packages.detail.dependencies'|trans }}</th>
                    <td>
                        {% if package.dependencies is not empty %}
                            {% for dependency in package.dependencies %}
                                <span class="studio-badge studio-badge-neutral">{{ dependency }}</span>
                            {% endfor %}
                        {% else %}
                            <span class="studio-muted">{{ 'admin.packages.detail.dependencies_empty'|trans }}</span>
                        {% endif %}
                    </td>
                </tr>
                {% if package.homepage %}
                    <tr>
                        <th scope="row">{{ 'admin.packages.detail.homepage'|trans }}</th>
                        <td><a href="{{ package.homepage }}" rel="noreferrer">{{ package.homepage }}</a></td>
                    </tr>
                {% endif %}
                {% if package.source %}
                    <tr>
                        <th scope="row">{{ 'admin.packages.detail.source'|trans }}</th>
                        <td><a href="{{ package.source_url|default(package.source) }}" rel="noreferrer">{{ package.source_url|default(package.source) }}</a></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </section>

    {% if package.readme %}
        <section class="studio-panel studio-markdown">
            <h2>{{ 'admin.packages.detail.readme_title'|trans }}</h2>
            {{ package.readme|studio_markdown('readme')|raw }}
        </section>
    {% endif %}
{% endblock %}
