{% extends '@backend/admin.html.twig' %}

{% set package = review.package %}
{% set action_key = review.action_key %}
{% set plan = review.plan %}

{% block title %}{{ ('admin.packages.lifecycle.' ~ action_key ~ '.title')|trans({'%package%': package.label}) }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'admin.packages.title'|trans,
        title: ('admin.packages.lifecycle.' ~ action_key ~ '.title')|trans({'%package%': package.label}),
    } only %}

    <section class="system-panel">
        <h2>{{ 'admin.packages.lifecycle.review_title'|trans }}</h2>
        <p class="system-muted">{{ ('admin.packages.lifecycle.' ~ action_key ~ '.text')|trans({'%package%': package.label}) }}</p>
        {% if action_key in ['purge', 'delete'] %}
            <p class="system-alert system-alert-warning">{{ ('admin.packages.lifecycle.' ~ action_key ~ '.warning')|trans({'%package%': package.label}) }}</p>
        {% endif %}

        {% if package.immutable %}
            <p class="system-alert system-alert-warning">{{ 'admin.packages.lifecycle.immutable'|trans }}</p>
        {% elseif plan and plan.success %}
            {% set changes = plan.value.changes|default([]) %}
            {% if changes is not empty %}
                <table class="system-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'admin.packages.table.package'|trans }}</th>
                            <th scope="col">{{ 'admin.packages.lifecycle.table.action'|trans }}</th>
                            <th scope="col">{{ 'admin.packages.table.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for change in changes %}
                            <tr>
                                <td><code>{{ change.package }}</code></td>
                                <td>{{ change.action }}</td>
                                <td>{{ change.status }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="system-muted">{{ 'admin.packages.lifecycle.no_changes'|trans }}</p>
            {% endif %}

            {% if lifecycle_mutable|default(false) %}
                <form
                    method="post"
                    action="{{ app.request.pathInfo }}"
                    data-controller="operation-overlay"
                    data-action="submit->operation-overlay#submit"
                    data-operation-overlay-enabled-value="true"
                    data-operation-overlay-redirect-on-success-value="{{ action_key == 'purge' ? '/admin/packages' : '/admin/packages/' ~ (package.package_name|url_encode) }}"
                >
                    <input type="hidden" name="_form_id" value="package-lifecycle-{{ review.action }}-{{ package.package_name }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('package-lifecycle-' ~ review.action ~ '-' ~ package.package_name) }}">
                    <button class="system-backend-button system-button-{{ action_key in ['purge', 'delete'] ? 'danger' : 'primary' }}" type="submit">
                        {{ ('admin.packages.lifecycle.' ~ action_key ~ '.submit')|trans }}
                    </button>
                    <a class="system-backend-button system-button-secondary" href="/admin/packages/{{ package.package_name }}">
                        {{ 'admin.packages.lifecycle.cancel'|trans }}
                    </a>
                </form>
            {% else %}
                <p class="system-alert system-alert-warning">{{ 'admin.acl.read_only_action'|trans }}</p>
                <a class="system-backend-button system-button-secondary" href="/admin/packages/{{ package.package_name }}">
                    {{ 'admin.packages.lifecycle.cancel'|trans }}
                </a>
            {% endif %}
        {% else %}
            {% for issue in plan.issues|default([]) %}
                <p class="system-alert system-alert-warning">{{ issue.translation_key|trans(issue.parameters) }}</p>
            {% else %}
                <p class="system-alert system-alert-warning">{{ 'admin.packages.lifecycle.unavailable'|trans }}</p>
            {% endfor %}
            <a class="system-backend-button system-button-secondary" href="/admin/packages/{{ package.package_name }}">
                {{ 'admin.packages.lifecycle.cancel'|trans }}
            </a>
        {% endif %}
    </section>
{% endblock %}
