{% extends '@backend/admin.html.twig' %}

{% set packages = extension_packages() %}

{% block title %}{{ 'admin.packages.title'|trans }}{% endblock %}

{% block admin_sidebar %}
    <nav aria-label="{{ 'ui.admin.navigation'|trans }}">
        {% include '@backend/partials/navigation/_tree.html.twig' with {items: navigation} only %}
    </nav>
{% endblock %}

{% block admin_body %}
    {% set backend_actions %}
        <div class="studio-backend-button-group">
            <button class="studio-backend-button studio-button-primary" type="button" onclick="document.getElementById('package-install-dialog')?.showModal()">
                {{ 'admin.packages.install.label'|trans }}
            </button>
            {% include '@backend/admin/partials/_backend-actions.html.twig' with {
                actions: backend_actions(['package_discovery']),
                class: 'studio-backend-button-group-inline',
            } only %}
        </div>
    {% endset %}

    {% include '@backend/admin/partials/_page-header.html.twig' with {
        eyebrow: 'ui.admin.area'|trans,
        title: 'admin.packages.title'|trans,
        actions: backend_actions,
    } only %}

    {% include '@backend/partials/feedback/_message.html.twig' with {message: message} only %}

    <dialog id="package-install-dialog" class="studio-dialog">
        <form method="dialog" class="studio-dialog-close">
            <button class="studio-backend-button studio-button-secondary" type="submit">
                {{ 'admin.packages.install.close'|trans }}
            </button>
        </form>
        <h2>{{ 'admin.packages.install.title'|trans }}</h2>
        <p class="studio-muted">{{ 'admin.packages.install.text'|trans }}</p>
        <form
            method="post"
            action="{{ path('backend_admin_package_install') }}"
            enctype="multipart/form-data"
            data-controller="operation-overlay"
            data-action="submit->operation-overlay#submit"
            data-operation-overlay-enabled-value="true"
            data-operation-overlay-redirect-on-success-value="/admin/packages"
        >
            <input type="hidden" name="_form_id" value="package-install">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('package-install') }}">
            <label class="studio-form-field">
                <span>{{ 'admin.packages.install.file'|trans }}</span>
                <input type="file" name="package_zip" accept=".zip,application/zip" required>
            </label>
            <button class="studio-backend-button studio-button-primary" type="submit">
                {{ 'admin.packages.install.submit'|trans }}
            </button>
        </form>
    </dialog>

    <section class="studio-panel">
        <h2>{{ 'admin.packages.registry_title'|trans }}</h2>
        <p class="studio-muted">{{ 'admin.packages.registry_text'|trans }}</p>

        {% if packages|length > 0 %}
            <table class="studio-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'admin.packages.table.package'|trans }}</th>
                        <th scope="col">{{ 'admin.packages.table.status'|trans }}</th>
                        <th scope="col">{{ 'admin.packages.table.scopes'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for package in packages %}
                        {% set row_classes = package.immutable ? 'is-immutable' : '' %}
                        {% set row_classes = package.available_version|default(null) ? (row_classes ~ ' has-update')|trim : row_classes %}
                        <tr {{ html_attributes({
                            class: row_classes ?: null,
                            'data-package-name': package.package_name,
                            'data-package-status': package.status,
                            'data-immutable': package.immutable ? 'true' : null,
                        }) }}>
                            {% set package_version = package.installed_version|default(package.manifest_version|default(null)) %}
                            <th scope="row">
                                <strong>
                                    <a href="{{ package.detail_path }}">{{ package.label_key ? package.label_key|trans : package.label }}</a>
                                </strong>
                                {% if package_version %}
                                    <span class="studio-muted">{{ package_version }}</span>
                                {% endif %}
                                {% if package.available_version|default(null) %}
                                    <strong class="studio-badge studio-badge-warning">&gt; {{ package.available_version }}</strong>
                                {% endif %}
                            </th>
                            <td>
                                <span class="studio-badge studio-badge-{{ package.status_tone }}">
                                    {{ package.status_label_key|trans }}
                                </span>
                            </td>
                            <td>
                                {% for scope in package.scopes %}
                                    <span class="studio-badge studio-badge-neutral">{{ scope.label_key|trans }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="studio-muted">{{ 'admin.packages.empty'|trans }}</p>
        {% endif %}
    </section>
{% endblock %}
