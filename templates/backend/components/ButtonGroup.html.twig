{% props actions = [], class = '' %}

<div {{ attributes.defaults({class: ['system-backend-button-group', class]|filter(item => item is not empty)|join(' ')}) }}>
    {% for action in actions %}
        <twig:backend:Button
            :label="action.label"
            :href="action.href|default(null)"
            :type="action.type|default(null)"
            :variant="action.variant|default('secondary')"
            :class="action.class|default('')"
        />
    {% endfor %}
</div>
