<section
    class="system-backend-action-log-overlay"
    aria-labelledby="system-backend-action-log-heading"
    data-operation-overlay-root
    data-label-starting="{{ 'ui.operations.action_log.states.starting'|trans }}"
    data-label-completed="{{ 'ui.operations.action_log.states.completed'|trans }}"
    data-label-requires-review="{{ 'ui.operations.action_log.states.requires_review'|trans }}"
    data-label-failed="{{ 'ui.operations.action_log.states.failed'|trans }}"
    data-label-start-error="{{ 'ui.operations.action_log.states.start_error'|trans }}"
    data-label-status-error="{{ 'ui.operations.action_log.states.status_error'|trans }}"
    data-label-request-error="{{ 'ui.operations.action_log.states.request_error'|trans }}"
    data-label-waiting="{{ 'ui.operations.action_log.states.waiting'|trans }}"
    data-label-result="{{ 'ui.operations.action_log.result'|trans }}"
    data-label-ok="{{ 'ui.operations.action_log.actions.ok'|trans }}"
    data-label-continue="{{ 'ui.operations.action_log.actions.continue'|trans }}"
    data-label-retry="{{ 'ui.operations.action_log.actions.retry'|trans }}"
    data-label-cancel="{{ 'ui.operations.action_log.actions.cancel'|trans }}"
    data-label-refresh="{{ 'ui.operations.action_log.actions.refresh'|trans }}"
    data-label-close="{{ 'ui.operations.action_log.actions.close'|trans }}"
    data-label-show-details="{{ 'ui.operations.action_log.actions.show_details'|trans }}"
    data-label-status-queued="{{ 'ui.operations.action_log.statuses.queued'|trans }}"
    data-label-status-pending="{{ 'ui.operations.action_log.statuses.pending'|trans }}"
    data-label-status-running="{{ 'ui.operations.action_log.statuses.running'|trans }}"
    data-label-status-success="{{ 'ui.operations.action_log.statuses.success'|trans }}"
    data-label-status-requires-review="{{ 'ui.operations.action_log.statuses.requires_review'|trans }}"
    data-label-status-warning="{{ 'ui.operations.action_log.statuses.warning'|trans }}"
    data-label-status-skipped="{{ 'ui.operations.action_log.statuses.skipped'|trans }}"
    data-label-status-failed="{{ 'ui.operations.action_log.statuses.failed'|trans }}"
    data-action-labels="{{ {
        select_language: 'setup.steps.select_language'|trans,
        write_environment: 'setup.steps.write_environment'|trans,
        dump_environment: 'setup.steps.dump_environment'|trans,
        run_migrations: 'setup.steps.run_migrations'|trans,
        seed_default_settings: 'setup.steps.seed_default_settings'|trans,
        seed_admin_user: 'setup.steps.seed_admin_user'|trans,
        seed_initial_content: 'setup.steps.seed_initial_content'|trans,
        clear_cache: 'setup.steps.clear_cache'|trans,
        run_package_discovery: 'setup.steps.run_package_discovery'|trans,
        run_asset_rebuild: 'setup.steps.run_asset_rebuild'|trans,
        mark_setup_completed: 'setup.steps.mark_setup_completed'|trans,
    }|json_encode|e('html_attr') }}"
    hidden
>
    <div class="system-backend-action-log-panel" role="dialog" aria-modal="true">
        <header class="system-backend-action-log-header">
            <div>
                <h2 id="system-backend-action-log-heading">{{ 'ui.operations.action_log.title'|trans }}</h2>
            </div>
            <button class="system-backend-action-log-close" type="button" data-operation-overlay-close-icon hidden aria-label="{{ 'ui.operations.action_log.actions.close'|trans }}">
                <span aria-hidden="true">×</span>
            </button>
            <span class="system-backend-action-log-spinner" data-operation-overlay-spinner aria-hidden="true"></span>
        </header>

        {% include '@backend/operations/partials/_action-log-summary.html.twig' with {summary: summary|default({})} only %}

        <div class="system-backend-action-log-scroll" data-operation-overlay-scroll>
            <ol class="system-backend-action-log-list" data-operation-overlay-list>
                {% for entry in entries|default([]) %}
                    {% include '@backend/operations/partials/_action-log-entry.html.twig' with {entry: entry} only %}
                {% else %}
                    <li class="system-muted" data-operation-overlay-empty>{{ 'ui.operations.action_log.empty'|trans }}</li>
                {% endfor %}
            </ol>
        </div>

        <footer class="system-backend-action-log-footer">
            <button class="system-backend-button system-button-success" type="button" data-operation-overlay-ok hidden>
                {{ 'ui.operations.action_log.actions.ok'|trans }}
            </button>
            <button class="system-backend-button system-button-primary" type="button" data-operation-overlay-continue hidden>
                {{ 'ui.operations.action_log.actions.continue'|trans }}
            </button>
            <button class="system-backend-button system-button-warning" type="button" data-operation-overlay-retry hidden>
                {{ 'ui.operations.action_log.actions.retry'|trans }}
            </button>
            <button class="system-backend-button system-button-secondary" type="button" data-operation-overlay-refresh hidden>
                {{ 'ui.operations.action_log.actions.refresh'|trans }}
            </button>
            <button class="system-backend-button system-button-danger" type="button" data-operation-overlay-cancel hidden>
                {{ 'ui.operations.action_log.actions.cancel'|trans }}
            </button>
            <button class="system-backend-button system-button-secondary" type="button" data-operation-overlay-close hidden>
                {{ 'ui.operations.action_log.actions.close'|trans }}
            </button>
        </footer>
    </div>
</section>
