{% extends '@root/base.html.twig' %}

{% block body_class %}system-body system-backend{% endblock %}

{% block body %}
    <main class="system-backend-shell">
        <div class="system-backend-admin-shell">
            {% include '@backend/partials/layout/_sidebar.html.twig' with {
                area: 'admin',
                label_key: 'ui.admin.navigation',
                sidebar_content: block('admin_sidebar'),
            } only %}
            <section class="system-backend-admin-content">
                {% include '@backend/partials/layout/_topbar.html.twig' with {
                    area_key: 'ui.admin.area',
                    actions: backend_actions(['asset_rebuild', 'cache_clear']),
                } only %}
                <div class="system-backend-admin-content-inner">
                    {% include '@backend/partials/feedback/_flash-stack.html.twig' %}
                    {% block admin_body %}{% endblock %}
                </div>
            </section>
        </div>
        {% include '@root/partials/layout/_system-footer.html.twig' with {area: 'backend'} only %}
    </main>
    {% include '@backend/operations/action-log-overlay.html.twig' %}
{% endblock %}
