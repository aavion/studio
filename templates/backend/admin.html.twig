{% extends '@root/base.html.twig' %}

{% block body_class %}studio-body studio-backend{% endblock %}

{% block body %}
    <main class="studio-backend-shell">
        <div class="studio-admin-shell">
            {% include '@backend/partials/layout/_sidebar.html.twig' with {
                area: 'admin',
                label_key: 'ui.admin.navigation',
                sidebar_content: block('admin_sidebar'),
            } only %}
            <section class="studio-admin-content">
                {% include '@backend/partials/layout/_topbar.html.twig' with {area_key: 'ui.admin.area'} only %}
                {% block admin_body %}{% endblock %}
            </section>
        </div>
    </main>
{% endblock %}
