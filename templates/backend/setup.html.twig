{% extends '@root/base.html.twig' %}

{% block body_class %}system-body system-backend{% endblock %}

{% block body %}
    <main class="system-backend-shell">
        <div class="system-backend-setup-frame">
            <header class="system-backend-setup-chrome" aria-label="{{ 'setup.chrome.label'|trans }}">
                {% include '@root/partials/brand/_brand.html.twig' with {
                    class: 'system-brand system-backend-setup-logo',
                    href: path('backend_setup_index'),
                    name: setup_app_name|default('Studio'),
                } only %}
                <span class="system-backend-setup-menu-stub">
                    <span class="ti ti-wand" aria-hidden="true"></span>
                    {{ 'setup.chrome.stub'|trans }}
                </span>
            </header>
            <section class="system-backend-setup-shell">
                <div class="system-backend-setup-content">
                    {% block setup_body %}{% endblock %}
                </div>
            </section>
            {% include '@root/partials/layout/_system-footer.html.twig' with {area: 'backend'} only %}
        </div>
    </main>
    {% include '@backend/operations/action-log-overlay.html.twig' %}
{% endblock %}
