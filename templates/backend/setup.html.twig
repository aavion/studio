{% extends '@root/base.html.twig' %}

{% block body_class %}studio-body studio-backend{% endblock %}

{% block body %}
    <main class="studio-backend-shell">
        <section class="studio-setup-shell">
            {% include '@backend/partials/layout/_topbar.html.twig' with {area_key: 'ui.setup.area'} only %}
            <div class="studio-setup-content">
                {% block setup_body %}{% endblock %}
            </div>
        </section>
        <footer class="studio-shell-footer">
            {{ setup_footer_copyright|default('')|studio_markdown('basic')|raw }}
        </footer>
    </main>
    {% include '@backend/operations/action-log-overlay.html.twig' %}
{% endblock %}
