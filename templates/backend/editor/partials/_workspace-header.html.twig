<header class="system-page-header">
    <div>
        <div class="system-kicker">{{ eyebrow|default('ui.editor.area'|trans) }}</div>
        <h1>{{ title }}</h1>
    </div>
    {% if status is defined and status is not empty %}
        <span class="system-badge system-badge-neutral">{{ status }}</span>
    {% endif %}
</header>
