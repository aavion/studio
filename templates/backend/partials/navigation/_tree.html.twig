{% set expand_active_branch_only = expand_active_branch_only|default(true) %}

{% if items|length > 0 %}
    <ul class="system-backend-nav">
        {% for item in items %}
            {% set children_visible = item.children|length > 0 and (not expand_active_branch_only or item.active or item.active_ancestor) %}
            {% set item_classes = [
                item.active ? 'is-active' : '',
                item.active_ancestor ? 'is-active-ancestor' : '',
                item.children|length > 0 ? 'has-children' : '',
                item.children|length > 0 and not children_visible ? 'is-collapsed' : '',
            ]|filter(item_class => item_class is not empty)|join(' ') %}
            {% set link_attributes = item.metadata.link_attributes|default({})|merge({
                'aria-current': item.active ? 'page' : false,
                'aria-expanded': item.children|length > 0 ? (children_visible ? 'true' : 'false') : false,
            }) %}
            <li{% if item_classes %} class="{{ item_classes }}"{% endif %}>
                <a href="{{ item.url }}" {{ html_attributes(link_attributes) }}>{{ item.label|trans }}</a>
                {% if children_visible %}
                    {% include '@backend/partials/navigation/_tree.html.twig' with {
                        items: item.children,
                        expand_active_branch_only: expand_active_branch_only,
                    } only %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
