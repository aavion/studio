{% set field_id = id|default(name|default('field')) %}
{% set textarea_control %}
    <textarea
        id="{{ field_id }}"
        class="system-backend-textarea"
        name="{{ name }}"
        rows="{{ rows|default(6) }}"
        {% if required|default(false) %}required{% endif %}
        {{ html_attributes(attributes|default({})) }}
    >{{ value|default('') }}</textarea>
{% endset %}
{% include '@backend/partials/forms/_field.html.twig' with {
    id: field_id,
    label: label,
    required: required|default(false),
    control: textarea_control,
    help: help|default(null),
    errors: errors|default([]),
} only %}
