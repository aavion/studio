{% set field_id = id|default(name|default('field')) %}
{% set selected_values = values|default([]) %}
<fieldset id="{{ field_id }}" class="system-backend-choice-group">
    <legend class="system-backend-form-label">{{ label }}</legend>
    {% for option_value, option_label in options|default({}) %}
        {% set option_id = field_id ~ '-' ~ loop.index %}
        <label class="system-backend-checkbox-label" for="{{ option_id }}">
            <input
                id="{{ option_id }}"
                class="system-backend-checkbox"
                type="checkbox"
                name="{{ name }}[]"
                value="{{ option_value }}"
                {% if option_value in selected_values %}checked{% endif %}
            >
            <span>{{ option_label }}</span>
        </label>
    {% endfor %}
    {% include '@backend/partials/forms/_help.html.twig' with {help: help|default(null)} only %}
    {% include '@backend/partials/forms/_errors.html.twig' with {errors: errors|default([])} only %}
</fieldset>
