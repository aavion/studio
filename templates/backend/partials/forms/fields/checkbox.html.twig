{% set field_id = id|default(name|default('field')) %}
<div class="studio-backend-form-field studio-backend-form-field-checkbox">
    <label class="studio-backend-checkbox-label" for="{{ field_id }}">
        <input
            id="{{ field_id }}"
            class="studio-backend-checkbox"
            type="checkbox"
            name="{{ name }}"
            value="{{ value|default('1') }}"
            {% if checked|default(false) %}checked{% endif %}
            {% if required|default(false) %}required{% endif %}
        >
        <span>{{ label }}</span>
    </label>
    {% include '@backend/partials/forms/_help.html.twig' with {help: help|default(null)} only %}
    {% include '@backend/partials/forms/_errors.html.twig' with {errors: errors|default([])} only %}
</div>
