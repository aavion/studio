{% extends '@root/base.html.twig' %}

{% block body_class %}system-body system-frontend{% endblock %}

{% block body %}
    <div class="system-frontend-shell">
        {% include '@frontend/partials/layout/_skip-link.html.twig' %}
        {% include '@frontend/partials/layout/_header.html.twig' %}
        {% include '@frontend/partials/feedback/_flash-stack.html.twig' %}

        <main id="system-main" class="system-frontend-main">
            {% block frontend_body %}{% endblock %}
        </main>

        {% include '@root/partials/layout/_system-footer.html.twig' with {area: 'frontend'} only %}
    </div>
{% endblock %}
