{% set field_id = id|default(name|default('field')) %}
{% set range_control %}
    <input
        id="{{ field_id }}"
        class="system-range"
        type="range"
        name="{{ name }}"
        value="{{ value|default(min|default(0)) }}"
        min="{{ min|default(0) }}"
        max="{{ max|default(100) }}"
        step="{{ step|default(1) }}"
        {% if disabled|default(false) %}disabled{% endif %}
    >
{% endset %}
{% include '@frontend/partials/forms/_field.html.twig' with {
    id: field_id,
    label: label,
    required: false,
    control: range_control,
    help: help|default(null),
    errors: errors|default([]),
} only %}
