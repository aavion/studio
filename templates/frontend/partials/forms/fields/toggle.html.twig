{% set field_id = id|default(name|default('field')) %}
<div class="system-form-field system-form-field-toggle">
    <label class="system-toggle-label" for="{{ field_id }}">
        <input
            id="{{ field_id }}"
            class="system-toggle"
            type="checkbox"
            role="switch"
            name="{{ name }}"
            value="{{ value|default('1') }}"
            {% for attr_name, attr_value in attr|default({}) %}
                {{ attr_name }}="{{ attr_value }}"
            {% endfor %}
            {% if checked|default(false) %}checked{% endif %}
            {% if disabled|default(false) %}disabled{% endif %}
        >
        <span>{{ label }}</span>
    </label>
    {% include '@frontend/partials/forms/_help.html.twig' with {help: help|default(null)} only %}
    {% include '@frontend/partials/forms/_errors.html.twig' with {errors: errors|default([])} only %}
</div>
