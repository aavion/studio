{% set field_id = id|default(name|default('field')) %}
<fieldset id="{{ field_id }}" class="system-choice-group">
    <legend class="system-form-label">{{ label }}</legend>
    {% for option_value, option_label in options|default({}) %}
        {% set option_id = field_id ~ '-' ~ loop.index %}
        <label class="system-radio-label" for="{{ option_id }}">
            <input
                id="{{ option_id }}"
                class="system-radio"
                type="radio"
                name="{{ name }}"
                value="{{ option_value }}"
                {% if option_value == value|default(null) %}checked{% endif %}
                {% if required|default(false) %}required{% endif %}
            >
            <span>{{ option_label }}</span>
        </label>
    {% endfor %}
    {% include '@frontend/partials/forms/_help.html.twig' with {help: help|default(null)} only %}
    {% include '@frontend/partials/forms/_errors.html.twig' with {errors: errors|default([])} only %}
</fieldset>
