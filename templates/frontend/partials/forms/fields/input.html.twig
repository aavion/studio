{% set field_id = id|default(name|default('field')) %}
{% set input_type = type|default('text') %}
{% set input_control %}
    <input
        id="{{ field_id }}"
        class="studio-input"
        type="{{ input_type }}"
        name="{{ name }}"
        value="{{ value|default('') }}"
        {% if placeholder|default(null) %}placeholder="{{ placeholder }}"{% endif %}
        {% if required|default(false) %}required{% endif %}
        {% if disabled|default(false) %}disabled{% endif %}
        {% if autocomplete|default(null) %}autocomplete="{{ autocomplete }}"{% endif %}
        {{ html_attributes(attributes|default({})) }}
    >
{% endset %}
{% include '@frontend/partials/forms/_field.html.twig' with {
    id: field_id,
    label: label,
    required: required|default(false),
    control: input_control,
    help: help|default(null),
    errors: errors|default([]),
} only %}
