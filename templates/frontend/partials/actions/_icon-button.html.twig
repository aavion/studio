{% set button_variant = variant|default('ghost') %}
{% set button_class = ['studio-icon-button', 'studio-button-' ~ button_variant, class|default('')]|filter(item => item is not empty)|join(' ') %}

{% if href|default(null) %}
    <a class="{{ button_class }}" href="{{ href }}" aria-label="{{ label }}">
        <span class="studio-icon studio-icon-{{ icon }}" aria-hidden="true"></span>
    </a>
{% else %}
    <button class="{{ button_class }}" type="{{ type|default('button') }}" aria-label="{{ label }}">
        <span class="studio-icon studio-icon-{{ icon }}" aria-hidden="true"></span>
    </button>
{% endif %}
