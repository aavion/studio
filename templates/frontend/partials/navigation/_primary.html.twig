{% macro render_items(items) %}
    {% if items is not empty %}
        <ul class="studio-frontend-navigation-list">
            {% for item in items %}
                {% if item.label is not empty %}
                    <li class="studio-frontend-navigation-item studio-frontend-navigation-level-{{ item.level }}">
                        <a class="studio-frontend-navigation-link" href="{{ item.url }}">{{ item.label }}</a>
                        {{ _self.render_items(item.children) }}
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

<nav class="studio-frontend-navigation" aria-label="{{ 'ui.frontend.navigation'|trans }}">
    {% set items = studio_navigation('main', app.request.locale|default('en'), 3) %}
    {% block frontend_navigation_items %}
        {{ _self.render_items(items) }}
    {% endblock %}
</nav>
