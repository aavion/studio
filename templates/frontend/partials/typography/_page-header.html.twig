<header class="system-page-header">
    <div>
        {% if kicker|default(null) %}
            <div class="system-kicker">{{ kicker }}</div>
        {% endif %}
        <h1>{{ title }}</h1>
        {% if subtitle|default(null) %}
            <p class="system-page-subtitle">{{ subtitle }}</p>
        {% endif %}
    </div>
</header>
