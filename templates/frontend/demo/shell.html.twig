{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'demo.frontend.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="studio-content-page studio-frontend-demo">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            kicker: 'demo.kicker'|trans,
            title: 'demo.frontend.title'|trans,
            subtitle: 'demo.frontend.subtitle'|trans,
        } only %}

        {% include '@frontend/partials/actions/_button-group.html.twig' with {
            actions: [
                {label: 'demo.actions.primary'|trans, href: path('demo_backend'), variant: 'primary'},
                {label: 'demo.actions.secondary'|trans, href: path('content_home'), variant: 'secondary'},
            ],
        } only %}

        <div class="studio-demo-grid">
            <section class="studio-panel">
                <h2>{{ 'demo.frontend.content_title'|trans }}</h2>
                <p class="studio-muted">{{ 'demo.frontend.content_text'|trans }}</p>
                <div class="studio-rich-text">
                    <p>{{ 'demo.frontend.rich_text'|trans }}</p>
                </div>
            </section>

            {% include '@frontend/partials/feedback/_empty-state.html.twig' with {
                title: 'demo.empty.title'|trans,
                message: 'demo.empty.message'|trans,
            } only %}
        </div>

        <section class="studio-panel">
            <header class="studio-page-header">
                <div>
                    <p class="studio-kicker">{{ 'demo.form.kicker'|trans }}</p>
                    <h2>{{ 'demo.form.title'|trans }}</h2>
                </div>
                <span class="studio-badge studio-badge-info">{{ 'demo.badges.info'|trans }}</span>
            </header>

            <div class="studio-demo-grid">
                {% include '@frontend/partials/forms/_field.html.twig' with {
                    id: 'demo_frontend_title',
                    label: 'demo.form.title_label'|trans,
                    required: true,
                    help: 'demo.form.help'|trans,
                    control: '<input id="demo_frontend_title" class="studio-control" value="' ~ ('demo.form.value'|trans|e('html_attr')) ~ '">',
                } only %}
                {% include '@frontend/partials/forms/_field.html.twig' with {
                    id: 'demo_frontend_status',
                    label: 'demo.form.status_label'|trans,
                    control: '<select id="demo_frontend_status" class="studio-control"><option>' ~ ('demo.form.status_option'|trans|e) ~ '</option></select>',
                } only %}
            </div>
        </section>

        <section class="studio-panel">
            <h2>{{ 'demo.status.title'|trans }}</h2>
            <div class="studio-page-actions">
                <span class="studio-badge studio-badge-success">{{ 'demo.badges.success'|trans }}</span>
                <span class="studio-badge studio-badge-info">{{ 'demo.badges.info'|trans }}</span>
                <span class="studio-badge studio-badge-warning">{{ 'demo.badges.warning'|trans }}</span>
                <span class="studio-badge studio-badge-error">{{ 'demo.badges.error'|trans }}</span>
            </div>
        </section>
    </section>
{% endblock %}
