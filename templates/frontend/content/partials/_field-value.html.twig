{% if value is same as(null) %}
    <span class="system-muted">{{ 'ui.content.empty_value'|trans }}</span>
{% elseif value is same as(true) or value is same as(false) %}
    {{ value ? 'true' : 'false' }}
{% elseif value is iterable %}
    {% if value.html is defined %}
        <div class="system-rich-text">{{ value.html|raw }}</div>
    {% elseif value.markdown is defined %}
        <div class="system-rich-text">{{ value.markdown|render_markdown }}</div>
    {% else %}
        <pre class="system-code-block">{{ value|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endif %}
{% else %}
    <div class="system-rich-text">{{ value|render_markdown }}</div>
{% endif %}
