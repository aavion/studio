{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ content_view.title ?? content_view.content.slug }}{% endblock %}

{% block frontend_body %}
    <main class="system-frontend-content-page" data-content-uid="{{ content_view.content.uid }}" data-content-revision="{{ content_view.revision.uid }}">
        <article class="system-frontend-content-article">
            {% include '@frontend/partials/typography/_page-header.html.twig' with {
                kicker: content_view.content.slug,
                title: content_view.title,
                subtitle: content_view.subtitle,
            } only %}

            {% for injection in content_injections.before_content|default([]) %}
                {{ injection.content|raw }}
            {% endfor %}

            {{ content_fieldset|raw }}

            {% for injection in content_injections.after_content|default([]) %}
                {{ injection.content|raw }}
            {% endfor %}
        </article>
    </main>
{% endblock %}
