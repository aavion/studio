{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ injection.label|trans }}{% endblock %}

{% block frontend_body %}
    <main class="system-frontend-content-page" data-injection="{{ injection.uid }}">
        <article class="system-frontend-content-article">
            {% include '@frontend/partials/typography/_page-header.html.twig' with {
                kicker: injection.pathSlug,
                title: injection.label|trans,
                subtitle: null,
            } only %}
        </article>
    </main>
{% endblock %}
