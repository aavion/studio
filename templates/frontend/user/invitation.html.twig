{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'ui.user.invitation.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="studio-auth-panel">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            title: 'ui.user.invitation.title'|trans,
            subtitle: 'ui.user.invitation.subtitle'|trans({'%email%': account_token.email}),
        } only %}
        {% if not success|default(false) %}
            <p class="studio-muted">{{ 'ui.user.invitation.expires_at'|trans({'%expires_at%': account_token.expiresAt|date('Y-m-d H:i')}) }}</p>
        {% endif %}
        {% if success|default(false) %}
            <p class="studio-auth-notice">{{ 'ui.user.invitation.success'|trans }}</p>
            {% include '@frontend/partials/actions/_button-group.html.twig' with {
                actions: [{label: 'ui.user.login.submit'|trans, href: path('user_login'), variant: 'primary'}],
            } only %}
        {% else %}
            {% if errors|default([]) is not empty %}
                <ul class="studio-form-errors">
                    {% for error in errors %}
                        <li>
                            {% if error is iterable %}
                                {{ error.translation_key|trans(error.parameters|default({})) }}
                            {% else %}
                                {{ error|trans }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            <form
                method="post"
                class="studio-auth-form"
                data-controller="password-policy"
                data-password-policy-email-value="{{ account_token.email }}"
                data-password-policy-mismatch-message-value="{{ 'ui.user.password.errors.password_mismatch'|trans }}"
            >
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_invitation_' ~ account_token.uid) }}">
                {% include '@frontend/partials/forms/fields/input.html.twig' with {name: 'username', label: 'ui.user.invitation.username'|trans, required: true, autocomplete: 'username', attributes: {minlength: 5, maxlength: 30, pattern: '[A-Za-z][A-Za-z0-9_-]{4,29}', 'data-password-policy-target': 'username', 'data-action': 'input->password-policy#update'}} only %}
                {% include '@frontend/partials/forms/fields/input.html.twig' with {name: 'password', type: 'password', label: 'ui.user.password.new_password'|trans, required: true, autocomplete: 'new-password', help: 'ui.user.password.new_password_help'|trans, attributes: {minlength: 8, 'data-password-policy-target': 'password', 'data-action': 'input->password-policy#update'}} only %}
                {% include '@frontend/partials/forms/fields/input.html.twig' with {name: 'confirm_password', type: 'password', label: 'ui.user.password.confirm_password'|trans, required: true, autocomplete: 'new-password', attributes: {minlength: 8, 'data-password-policy-target': 'confirm', 'data-action': 'input->password-policy#update'}} only %}
                {% include '@root/partials/forms/_password_policy_meter.html.twig' only %}
                {% include '@frontend/partials/forms/fields/submit.html.twig' with {label: 'ui.user.invitation.submit'|trans} only %}
            </form>
        {% endif %}
    </section>
{% endblock %}
