{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'ui.user.password_reset.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="studio-auth-panel">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            title: 'ui.user.password_reset.title'|trans,
            subtitle: 'ui.user.password_reset.subtitle'|trans,
        } only %}
        {% if success|default(false) %}
            <p class="studio-auth-notice">{{ 'ui.user.password_reset.success'|trans }}</p>
        {% else %}
            {% if errors|default([]) is not empty %}
                <ul class="studio-form-errors">
                    {% for error in errors %}
                        <li>{{ error|trans }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            <form method="post" class="studio-auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_password_reset') }}">
                {% include '@frontend/partials/forms/fields/email.html.twig' with {
                    name: 'email',
                    label: 'ui.user.password_reset.email'|trans,
                    required: true,
                } only %}
                {% include '@frontend/partials/forms/fields/submit.html.twig' with {label: 'ui.user.password_reset.submit'|trans} only %}
            </form>
        {% endif %}
    </section>
{% endblock %}
