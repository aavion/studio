{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'ui.user.password.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="studio-auth-panel">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            title: 'ui.user.password.title'|trans,
            subtitle: 'ui.user.password.placeholder'|trans,
        } only %}
        {% if success|default(false) %}
            <p class="studio-auth-notice">{{ 'ui.user.password.success'|trans }}</p>
        {% endif %}
        {% if errors|default([]) is not empty %}
            <ul class="studio-form-errors">
                {% for error in errors %}
                    <li>{{ error|trans }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <form
            action="{{ path('user_password') }}"
            method="post"
            class="studio-auth-form"
            data-controller="password-policy"
            data-password-policy-username-value="{{ user_account.username }}"
            data-password-policy-email-value="{{ user_account.email }}"
            data-password-policy-mismatch-message-value="{{ 'ui.user.password.errors.password_mismatch'|trans }}"
        >
            {% include '@frontend/partials/forms/fields/input.html.twig' with {
                name: 'current_password',
                type: 'password',
                label: 'ui.user.password.current_password'|trans,
                autocomplete: 'current-password',
                required: true,
            } only %}
            {% include '@frontend/partials/forms/fields/input.html.twig' with {
                name: 'new_password',
                type: 'password',
                label: 'ui.user.password.new_password'|trans,
                autocomplete: 'new-password',
                required: true,
                help: 'ui.user.password.new_password_help'|trans,
                attributes: {minlength: 8, 'data-password-policy-target': 'password', 'data-action': 'input->password-policy#update'},
            } only %}
            {% include '@frontend/partials/forms/fields/input.html.twig' with {
                name: 'confirm_password',
                type: 'password',
                label: 'ui.user.password.confirm_password'|trans,
                autocomplete: 'new-password',
                required: true,
                attributes: {minlength: 8, 'data-password-policy-target': 'confirm', 'data-action': 'input->password-policy#update'},
            } only %}
            {% include '@root/partials/forms/_password_policy_meter.html.twig' only %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_password_change') }}">
            {% include '@frontend/partials/forms/fields/submit.html.twig' with {label: 'ui.user.password.submit'|trans} only %}
        </form>
    </section>
{% endblock %}
