{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'ui.user.api_keys.reveal.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="system-frontend-auth-panel">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            title: 'ui.user.api_keys.reveal.title'|trans,
            subtitle: 'ui.user.api_keys.reveal.subtitle'|trans,
        } only %}
        {% if plain_api_key|default(null) %}
            <section
                class="system-panel"
                data-controller="clipboard"
                data-clipboard-success-value="{{ 'ui.user.api_keys.reveal.copy_success'|trans }}"
                data-clipboard-failure-value="{{ 'ui.user.api_keys.reveal.copy_failure'|trans }}"
            >
                <h2>{{ api_key.prefix }}</h2>
                <code class="system-code" data-clipboard-target="source">{{ plain_api_key }}</code>
                <div class="system-toolbar">
                    <button class="system-button system-button-secondary" type="button" data-action="clipboard#copy">
                        {{ 'ui.user.api_keys.reveal.copy'|trans }}
                    </button>
                    <span class="system-muted" data-clipboard-target="status" hidden></span>
                </div>
            </section>
        {% else %}
            {% if errors|default([]) is not empty %}
                <ul class="system-form-errors">
                    {% for error in errors %}
                        <li>{{ error|trans }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            <form method="post" class="system-frontend-auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_api_key_reveal_' ~ api_key.uid) }}">
                {% include '@frontend/partials/forms/fields/input.html.twig' with {
                    name: 'password',
                    type: 'password',
                    label: 'ui.user.api_keys.reveal.password'|trans,
                    autocomplete: 'current-password',
                    required: true,
                } only %}
                {% include '@frontend/partials/forms/fields/submit.html.twig' with {label: 'ui.user.api_keys.reveal.submit'|trans} only %}
            </form>
        {% endif %}
    </section>
{% endblock %}
