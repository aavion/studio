{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'ui.user.profile.close.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="system-frontend-auth-panel">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            title: 'ui.user.profile.close.title'|trans,
            subtitle: 'ui.user.profile.close.subtitle'|trans,
        } only %}
        <p class="system-muted">{{ 'ui.user.profile.close.confirmation_message'|trans({'%days%': deleted_user_retention_days}) }}</p>
        <form method="post" action="{{ path('user_profile_close') }}" class="system-frontend-auth-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_profile_close') }}">
            {% include '@frontend/partials/forms/fields/input.html.twig' with {
                name: 'password',
                type: 'password',
                label: 'ui.user.profile.close.password'|trans,
                autocomplete: 'current-password',
                required: true,
            } only %}
            {% include '@frontend/partials/forms/fields/checkbox.html.twig' with {
                id: 'confirm_close',
                name: 'confirm_close',
                label: 'ui.user.profile.close.confirm'|trans,
                required: true,
            } only %}
            {% include '@frontend/partials/forms/fields/submit.html.twig' with {label: 'ui.user.profile.close.submit'|trans} only %}
        </form>
        {% include '@frontend/partials/actions/_button-group.html.twig' with {
            actions: [
                {label: 'ui.user.profile.close.cancel'|trans, href: path('user_profile'), variant: 'secondary'},
            ],
        } only %}
    </section>
{% endblock %}
