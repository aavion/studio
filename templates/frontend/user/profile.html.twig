{% extends '@frontend/frontend.html.twig' %}

{% block title %}{{ 'ui.user.profile.title'|trans }}{% endblock %}

{% block frontend_body %}
    <section class="system-frontend-auth-panel">
        {% include '@frontend/partials/typography/_page-header.html.twig' with {
            title: 'ui.user.profile.title'|trans,
            subtitle: 'ui.user.profile.subtitle'|trans,
        } only %}
        {% if errors|default([]) is not empty %}
            <ul class="system-form-errors">
                {% for error in errors %}
                    <li>{{ error|trans }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <dl class="system-frontend-user-summary">
            <div>
                <dt>{{ 'ui.user.profile.username'|trans }}</dt>
                <dd>{{ user_account.username }}</dd>
            </div>
            <div>
                <dt>{{ 'ui.user.profile.email'|trans }}</dt>
                <dd>{{ user_account.email }}</dd>
            </div>
            <div>
                <dt>{{ 'ui.user.profile.role'|trans }}</dt>
                <dd>{{ ('ui.user.roles.' ~ user_account.role.value)|trans }}</dd>
            </div>
        </dl>
        <form
            method="post"
            class="system-frontend-auth-form"
        >
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_profile') }}">
            {% if username_change_enabled|default(false) %}
                {% include '@frontend/partials/forms/fields/input.html.twig' with {
                    name: 'username',
                    label: 'ui.user.profile.username'|trans,
                    value: user_account.username,
                    required: true,
                    autocomplete: 'username',
                } only %}
            {% endif %}
            {% include '@frontend/partials/forms/fields/input.html.twig' with {
                name: 'email',
                type: 'email',
                label: 'ui.user.profile.email'|trans,
                value: user_account.email,
                required: true,
                autocomplete: 'email',
            } only %}
            {% include '@frontend/partials/forms/fields/input.html.twig' with {
                name: 'display_name',
                label: 'ui.user.profile.display_name'|trans,
                value: user_account.profile.display_name|default(''),
            } only %}
            {% include '@frontend/partials/forms/fields/select.html.twig' with {
                name: 'language',
                label: 'ui.user.profile.language'|trans,
                value: user_account.settings.language|default('default'),
                options: ({
                    default: 'ui.user.profile.language_default'|trans,
                })|merge(language_options|default({})),
            } only %}
            {% include '@frontend/partials/forms/fields/submit.html.twig' with {label: 'ui.user.profile.submit'|trans} only %}
        </form>
        {% set profile_actions = [
            {label: 'ui.user.password.title'|trans, href: path('user_password'), variant: 'secondary'},
        ] %}
        {% if api_key_management_enabled|default(false) %}
            {% set profile_actions = profile_actions|merge([
                {label: 'ui.user.api_keys.title'|trans, href: path('user_api_keys'), variant: 'secondary'},
            ]) %}
        {% endif %}
        {% include '@frontend/partials/actions/_button-group.html.twig' with {actions: profile_actions} only %}
        <section class="system-panel">
            <h2>{{ 'ui.user.profile.close.title'|trans }}</h2>
            <p class="system-muted">{{ 'ui.user.profile.close.message'|trans }}</p>
            {% include '@frontend/partials/actions/_button-group.html.twig' with {
                actions: [
                    {label: 'ui.user.profile.close.open'|trans, href: path('user_profile_close'), variant: 'secondary'},
                ],
            } only %}
        </section>
    </section>
{% endblock %}
