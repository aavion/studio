{% extends 'layouts/frontend.html.twig' %}

{% block title %}{{ content_view.title ?? content_view.content.slug }}{% endblock %}

{% block frontend_body %}
    <main class="studio-content-page" data-content-uid="{{ content_view.content.uid }}" data-content-revision="{{ content_view.revision.uid }}">
        <article class="studio-content-article">
            <header class="studio-content-header">
                <div class="studio-kicker">{{ content_view.content.slug }}</div>
                <h1>{{ content_view.title }}</h1>

                {% if content_view.subtitle %}
                    <p class="studio-content-subtitle">{{ content_view.subtitle }}</p>
                {% endif %}
            </header>

            {% include 'content/partials/_generic-fields.html.twig' with {content_view: content_view} only %}
        </article>
    </main>
{% endblock %}
