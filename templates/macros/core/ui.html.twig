{% macro button(label, href = null, variant = 'primary') %}
    {% set class_names = 'system-button system-button-' ~ variant %}
    {% if href %}
        <a class="{{ class_names }}" href="{{ href }}">{{ label }}</a>
    {% else %}
        <button class="{{ class_names }}" type="button">{{ label }}</button>
    {% endif %}
{% endmacro %}

{% macro badge(label, tone = 'neutral') %}
    <span class="system-badge system-badge-{{ tone }}">{{ label }}</span>
{% endmacro %}
