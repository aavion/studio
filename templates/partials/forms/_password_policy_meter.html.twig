<div class="system-password-meter" aria-live="polite">
    <meter min="0" max="6" value="0" data-password-policy-target="meter"></meter>
    <ul>
        <li data-password-policy-target="rule" data-password-rule="length">{{ 'ui.user.password.policy.length'|trans }}</li>
        <li data-password-policy-target="rule" data-password-rule="classes">{{ 'ui.user.password.policy.classes'|trans }}</li>
        <li data-password-policy-target="rule" data-password-rule="personal">{{ 'ui.user.password.policy.personal'|trans }}</li>
        <li data-password-policy-target="rule" data-password-rule="repeated">{{ 'ui.user.password.policy.repeated'|trans }}</li>
        <li data-password-policy-target="rule" data-password-rule="match">{{ 'ui.user.password.policy.match'|trans }}</li>
    </ul>
</div>
